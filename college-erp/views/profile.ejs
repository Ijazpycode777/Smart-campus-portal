<%- include('partials/layout-top') %>
<%
  const roleColor = { admin: '#6366f1', teacher: '#10b981', student: '#ec4899' };
  const roleBadge = { admin: 'badge-purple', teacher: 'badge-success', student: 'badge-info' };
  // Activity data may be passed as `activity` local; default to empty array
  const recentActivity = typeof activity !== 'undefined' ? activity : [];
%>

<div class="hero-banner fade-in">
  <div style="position:relative;display:flex;align-items:center;gap:20px;flex-wrap:wrap">
    <div class="avatar avatar-xl" style="background:<%= currentUser.avatarColor %>;width:88px;height:88px;font-size:30px;box-shadow:0 8px 24px rgba(0,0,0,.2);border:3px solid rgba(255,255,255,.4)"><%= helpers.initials(currentUser.fullName) %></div>
    <div style="flex:1;min-width:220px">
      <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">My Account</div>
      <h1 style="margin-top:4px"><%= currentUser.fullName %></h1>
      <p style="margin-top:4px">@<%= currentUser.username %> · <%= currentUser.email %></p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
        <span class="badge <%= roleBadge[currentUser.role] || 'badge-neutral' %> badge-dot"><%= (currentUser.role || 'user').toUpperCase() %></span>
        <span class="badge badge-neutral">User ID #<%= currentUser.id %></span>
      </div>
    </div>
    <div style="text-align:right">
      <div style="font-size:32px;font-weight:800;line-height:1"><%= recentActivity.length %></div>
      <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.06em">Recent Actions</div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body" style="padding:0">
    <div class="tabs" style="padding:0 18px">
      <button class="tab active" data-tab="profile">👤 Profile</button>
      <button class="tab" data-tab="security">🔒 Security</button>
      <button class="tab" data-tab="activity">📊 Activity</button>
    </div>
  </div>
</div>

<div id="tab-profile" class="tab-panel">
  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">Profile Information</div>
        <div class="text-xs text-muted">Update your personal details — these are visible to other users.</div>
      </div>
      <span class="badge badge-info">Editable</span>
    </div>
    <div class="card-body">
      <form id="profileForm">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Full Name <span class="req">*</span></label>
            <input class="form-control" name="full_name" value="<%= currentUser.fullName %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">Username</label>
            <input class="form-control" name="username" value="<%= currentUser.username %>" disabled>
            <div class="form-hint">Username cannot be changed once set.</div>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Email <span class="req">*</span></label>
            <input class="form-control" type="email" name="email" value="<%= currentUser.email %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">Phone</label>
            <input class="form-control" name="phone" value="<%= typeof currentUser.phone !== 'undefined' ? currentUser.phone : '' %>" placeholder="+91 ...">
          </div>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:8px">
          <button type="reset" class="btn btn-ghost">Reset</button>
          <button type="button" class="btn btn-primary" id="saveProfileBtn" onclick="saveProfile()">💾 Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div id="tab-security" class="tab-panel" style="display:none">
  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">Change Password</div>
        <div class="text-xs text-muted">Use a strong password — at least 8 characters, mix of letters, numbers and symbols.</div>
      </div>
      <span class="badge badge-warning">Security</span>
    </div>
    <div class="card-body">
      <form id="passwordForm" onsubmit="event.preventDefault()">
        <div class="form-group">
          <label class="form-label">Current Password <span class="req">*</span></label>
          <input class="form-control" type="password" name="currentPassword" required autocomplete="current-password">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">New Password <span class="req">*</span></label>
            <input class="form-control" type="password" name="newPassword" id="newPassword" required autocomplete="new-password">
            <div class="form-hint">Min 8 characters with letters, numbers and a symbol.</div>
          </div>
          <div class="form-group">
            <label class="form-label">Confirm Password <span class="req">*</span></label>
            <input class="form-control" type="password" name="confirmPassword" id="confirmPassword" required autocomplete="new-password">
            <div class="form-error" id="confirmError" style="display:none">Passwords do not match.</div>
          </div>
        </div>
        <div style="margin-top:8px;padding:12px;background:var(--surface-2);border-radius:8px;font-size:12px;color:var(--gray-600)">
          <strong>Password Strength:</strong>
          <div style="height:6px;background:var(--gray-100);border-radius:3px;margin-top:6px;overflow:hidden">
            <div id="strengthBar" style="height:100%;width:0%;background:var(--danger);transition:all .3s"></div>
          </div>
          <div id="strengthLabel" style="margin-top:4px;font-weight:600;color:var(--gray-500)">Type a password to see strength.</div>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:16px">
          <button type="reset" class="btn btn-ghost">Clear</button>
          <button type="button" class="btn btn-primary" id="savePasswordBtn" onclick="changePassword()">🔐 Update Password</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header">
      <div>
        <div class="card-title">Account Status</div>
      </div>
    </div>
    <div class="card-body">
      <div style="display:grid;gap:10px">
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px;background:var(--surface-2);border-radius:8px">
          <div><strong>Account Status</strong><div class="text-xs text-muted">Active accounts can sign in</div></div>
          <span class="badge badge-success badge-dot">Active</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px;background:var(--surface-2);border-radius:8px">
          <div><strong>Two-Factor Auth</strong><div class="text-xs text-muted">Adds an extra layer of security</div></div>
          <span class="badge badge-neutral badge-dot">Not Enabled</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px;background:var(--surface-2);border-radius:8px">
          <div><strong>Last Password Change</strong><div class="text-xs text-muted">For your security, change passwords every 90 days</div></div>
          <span class="text-muted text-xs">—</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="tab-activity" class="tab-panel" style="display:none">
  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">Recent Activity</div>
        <div class="text-xs text-muted">Your most recent actions across the ERP</div>
      </div>
      <span class="badge badge-info"><%= recentActivity.length %> events</span>
    </div>
    <div class="card-body" style="padding:0">
      <% if (!recentActivity.length) { %>
        <div class="empty"><div class="empty-icon">📊</div><div class="empty-title">No activity yet</div><div class="empty-sub">Your actions will appear here as you use the system.</div></div>
      <% } else { %>
        <div style="max-height:520px;overflow-y:auto">
          <% recentActivity.forEach(a => { %>
            <div style="display:flex;gap:12px;padding:12px 20px;border-bottom:1px solid var(--border)">
              <div class="avatar avatar-sm" style="background:<%= currentUser.avatarColor %>"><%= helpers.initials(a.full_name || currentUser.fullName) %></div>
              <div style="flex:1;min-width:0">
                <div style="font-size:13px"><strong><%= a.action %></strong> <% if (a.entity_type) { %><span class="badge badge-neutral"><%= a.entity_type %></span><% } %></div>
                <div class="text-xs text-muted truncate"><%= a.details || '—' %></div>
                <div class="text-xs text-muted"><%= helpers.timeAgo(a.created_at) %></div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  // Tab switching
  document.querySelectorAll('.tab[data-tab]').forEach(t => {
    t.addEventListener('click', () => {
      document.querySelectorAll('.tab[data-tab]').forEach(x => x.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.style.display = 'none');
      t.classList.add('active');
      document.getElementById('tab-' + t.dataset.tab).style.display = 'block';
    });
  });
  // Profile save
  async function saveProfile() {
    const form = document.getElementById('profileForm');
    const data = {};
    form.querySelectorAll('[name]').forEach(i => { if (!i.disabled) data[i.name] = i.value; });
    const btn = document.getElementById('saveProfileBtn');
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const res = await ERP.api('/api/auth/profile', { method: 'PUT', body: data });
      ERP.toast('Profile Saved', res.message || 'Your profile has been updated.', 'success');
      setTimeout(() => location.reload(), 1200);
    } catch (err) { ERP.toast('Error', err.message, 'error'); btn.disabled = false; btn.textContent = '💾 Save Changes'; }
  }
  // Password strength
  const newPassword = document.getElementById('newPassword');
  const confirmPassword = document.getElementById('confirmPassword');
  const strengthBar = document.getElementById('strengthBar');
  const strengthLabel = document.getElementById('strengthLabel');
  const confirmError = document.getElementById('confirmError');
  newPassword.addEventListener('input', () => {
    const v = newPassword.value;
    let score = 0;
    if (v.length >= 8) score++;
    if (/[A-Z]/.test(v)) score++;
    if (/[0-9]/.test(v)) score++;
    if (/[^A-Za-z0-9]/.test(v)) score++;
    const pct = (score / 4) * 100;
    strengthBar.style.width = pct + '%';
    const labels = ['Too short', 'Weak', 'Fair', 'Good', 'Strong'];
    const colors = ['#ef4444', '#ef4444', '#f59e0b', '#3b82f6', '#10b981'];
    strengthLabel.textContent = labels[score] || 'Type a password';
    strengthLabel.style.color = colors[score] || '#6b7280';
    strengthBar.style.background = colors[score] || '#ef4444';
    checkMatch();
  });
  confirmPassword.addEventListener('input', checkMatch);
  function checkMatch() {
    if (!confirmPassword.value) { confirmError.style.display = 'none'; return false; }
    const match = newPassword.value === confirmPassword.value;
    confirmError.style.display = match ? 'none' : 'block';
    return match;
  }
  // Password change
  async function changePassword() {
    if (!checkMatch()) { ERP.toast('Warning', 'Passwords do not match.', 'warning'); return; }
    if (newPassword.value.length < 8) { ERP.toast('Warning', 'Password must be at least 8 characters.', 'warning'); return; }
    const form = document.getElementById('passwordForm');
    const data = {};
    form.querySelectorAll('[name]').forEach(i => { data[i.name] = i.value; });
    const btn = document.getElementById('savePasswordBtn');
    btn.disabled = true; btn.textContent = 'Updating…';
    try {
      const res = await ERP.api('/api/auth/change-password', { method: 'POST', body: data });
      ERP.toast('Password Updated', res.message || 'Your password has been changed successfully.', 'success');
      form.reset();
      strengthBar.style.width = '0%';
      strengthLabel.textContent = 'Type a password to see strength.';
      strengthLabel.style.color = 'var(--gray-500)';
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
    btn.disabled = false; btn.textContent = '🔐 Update Password';
  }
</script>
<%- include('partials/layout-bottom') %>
