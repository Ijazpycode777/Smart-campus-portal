<%- include('../partials/layout-top') %>
<%
  const totalStudents = submissions.length + notSubmitted.length;
  const subRate = totalStudents ? Math.round(submissions.length / totalStudents * 100) : 0;
  const graded = submissions.filter(s => s.marks_obtained !== null && s.marks_obtained !== undefined);
  const now = new Date();
  const overdue = new Date(assignment.due_date) < now;
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/teacher">Dashboard</a> / <a href="/teacher/assignments">Assignments</a> / <%= assignment.title %></div>
    <h1><%= assignment.title %></h1>
  </div>
  <a href="/teacher/assignments" class="btn btn-ghost">← Back</a>
</div>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Assignment Detail</div>
    <h1><%= assignment.title %></h1>
    <p><%= assignment.subject_code %> — <%= assignment.subject_name %> · <%= assignment.class_name %></p>
    <div style="display:flex;gap:24px;flex-wrap:wrap;margin-top:10px">
      <div><div class="text-xs" style="opacity:.85">Due Date</div><div style="font-weight:800;font-size:16px;color:<%= overdue ? '#fca5a5' : '#fff' %>"><%= helpers.formatDate(assignment.due_date) %></div></div>
      <div><div class="text-xs" style="opacity:.85">Total Marks</div><div style="font-weight:800;font-size:16px"><%= assignment.total_marks %></div></div>
      <div><div class="text-xs" style="opacity:.85">Submissions</div><div style="font-weight:800;font-size:16px"><%= submissions.length %>/<%= totalStudents %></div></div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">👥</div>
    <div style="flex:1">
      <div class="stat-label">Total Students</div>
      <div class="stat-value"><%= totalStudents %></div>
      <div class="stat-delta up">▲ In class</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">📥</div>
    <div style="flex:1">
      <div class="stat-label">Submitted</div>
      <div class="stat-value"><%= submissions.length %></div>
      <div class="stat-delta up">▲ Submissions in</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon red">📤</div>
    <div style="flex:1">
      <div class="stat-label">Not Submitted</div>
      <div class="stat-value"><%= notSubmitted.length %></div>
      <div class="stat-delta down">▼ Missing</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon amber">📊</div>
    <div style="flex:1">
      <div class="stat-label">Graded</div>
      <div class="stat-value"><%= graded.length %></div>
      <div class="stat-delta up">▲ Of <%= submissions.length %></div>
    </div>
  </div>
</div>

<div class="charts-grid" style="grid-template-columns:1fr 2fr">
  <div class="card">
    <div class="card-header">
      <div class="card-title">Submission Rate</div>
    </div>
    <div class="card-body" style="text-align:center;padding:24px">
      <svg data-ring="<%= subRate %>" data-ring-color="<%= subRate >= 75 ? '#10b981' : subRate >= 50 ? '#f59e0b' : '#ef4444' %>" data-ring-size="140" style="width:140px;height:140px;margin:0 auto"></svg>
      <div style="margin-top:14px;font-size:28px;font-weight:800;color:var(--brand-600)"><%= subRate %>%</div>
      <div class="text-xs text-muted"><%= submissions.length %> of <%= totalStudents %> students submitted</div>
      <div style="margin-top:14px;display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div style="padding:10px;background:var(--surface-2);border-radius:8px"><div class="text-xs text-muted">Submitted</div><div style="font-weight:800;color:var(--success)"><%= submissions.length %></div></div>
        <div style="padding:10px;background:var(--surface-2);border-radius:8px"><div class="text-xs text-muted">Missing</div><div style="font-weight:800;color:var(--danger)"><%= notSubmitted.length %></div></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">Assignment Brief</div>
    </div>
    <div class="card-body">
      <div style="font-size:14px;color:var(--gray-700);line-height:1.7"><%= assignment.description || 'No description provided.' %></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
        <span class="badge badge-info">📘 <%= assignment.subject_code %></span>
        <span class="badge badge-purple">🏫 <%= assignment.class_name %></span>
        <span class="badge <%= overdue ? 'badge-danger' : 'badge-warning' %>">📅 Due <%= helpers.formatDate(assignment.due_date) %></span>
        <span class="badge badge-neutral">🎯 <%= assignment.total_marks %> marks</span>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Submissions</div>
      <div class="text-xs text-muted">Grade each student's submission</div>
    </div>
    <span class="badge badge-info"><%= submissions.length %> submitted</span>
  </div>
  <div class="card-body">
    <% if (!submissions.length) { %>
      <div class="empty"><div class="empty-icon">📥</div><div class="empty-title">No submissions yet</div><div class="empty-sub">Student submissions will appear here once submitted.</div></div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Roll</th><th>Student</th><th>Submission</th><th>Submitted</th><th>Marks</th><th>Feedback</th><th></th></tr></thead>
          <tbody>
            <% submissions.forEach(s => { %>
              <tr data-sub="<%= s.id %>">
                <td><strong><%= s.roll_number %></strong></td>
                <td>
                  <div style="display:flex;align-items:center;gap:10px">
                    <div class="avatar avatar-sm" style="background:<%= s.avatar_color %>"><%= helpers.initials(s.full_name) %></div>
                    <div style="font-weight:600"><%= s.full_name %></div>
                  </div>
                </td>
                <td style="max-width:240px">
                  <div class="text-sm truncate" style="color:var(--gray-600)"><%= (s.submission_text || '').slice(0, 80) %><% if ((s.submission_text||'').length > 80) { %>…<% } %></div>
                  <% if (s.file_url) { %><a href="<%= s.file_url %>" target="_blank" class="text-xs" style="color:var(--brand-600)">📎 View file</a><% } %>
                </td>
                <td class="text-xs text-muted"><%= helpers.formatDateTime(s.submitted_at) %></td>
                <td style="min-width:120px">
                  <input type="number" class="form-control" min="0" max="<%= assignment.total_marks %>"
                         data-marks-sub="<%= s.id %>"
                         value="<%= s.marks_obtained !== null && s.marks_obtained !== undefined ? s.marks_obtained : '' %>"
                         placeholder="/ <%= assignment.total_marks %>">
                </td>
                <td style="min-width:220px">
                  <textarea class="form-textarea" data-feedback-sub="<%= s.id %>" rows="1" placeholder="Feedback"><%= s.feedback || '' %></textarea>
                </td>
                <td>
                  <button class="btn btn-primary btn-sm" onclick="gradeSubmission(<%= s.id %>)">Grade</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<% if (notSubmitted.length) { %>
  <div class="card">
    <div class="card-header">
      <div class="card-title">Not Submitted (<%= notSubmitted.length %>)</div>
    </div>
    <div class="card-body" style="padding:0">
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Roll</th><th>Student</th><th>Status</th></tr></thead>
          <tbody>
            <% notSubmitted.forEach(s => { %>
              <tr>
                <td><strong><%= s.roll_number %></strong></td>
                <td>
                  <div style="display:flex;align-items:center;gap:10px">
                    <div class="avatar avatar-sm" style="background:<%= s.avatar_color %>"><%= helpers.initials(s.full_name) %></div>
                    <div style="font-weight:600"><%= s.full_name %></div>
                  </div>
                </td>
                <td><span class="badge badge-danger badge-dot">Missing</span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<script>
  async function gradeSubmission(subId) {
    const marks = document.querySelector(`[data-marks-sub="${subId}"]`).value;
    const feedback = document.querySelector(`[data-feedback-sub="${subId}"]`).value;
    try {
      const res = await ERP.api('/api/teacher/assignments/submissions/' + subId + '/grade', {
        method: 'POST',
        body: { marks_obtained: marks === '' ? null : parseFloat(marks), feedback }
      });
      ERP.toast('Graded', res.message || 'Submission graded successfully.', 'success');
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
  }
</script>
<%- include('../partials/layout-bottom') %>
