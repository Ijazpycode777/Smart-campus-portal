<%- include('../partials/layout-top') %>
<%
  const totalResults = exams.reduce((a, e) => a + (e.results_count || 0), 0);
  const typeBadge = { midterm: 'info', final: 'danger', quiz: 'warning', assignment: 'purple', practical: 'success' };
  const typeIcon = { midterm: '📋', final: '🎯', quiz: '❓', assignment: '📝', practical: '🔬' };
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/teacher">Dashboard</a> / Examinations</div>
    <h1>Examinations</h1>
  </div>
  <button class="btn btn-primary" onclick="openCreateExam()">➕ Create Exam</button>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📝</div>
    <div style="flex:1">
      <div class="stat-label">Total Exams</div>
      <div class="stat-value"><%= exams.length %></div>
      <div class="stat-delta up">▲ Created by you</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">📊</div>
    <div style="flex:1">
      <div class="stat-label">Results Recorded</div>
      <div class="stat-value"><%= totalResults %></div>
      <div class="stat-delta up">▲ Across all exams</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">🎯</div>
    <div style="flex:1">
      <div class="stat-label">Final Exams</div>
      <div class="stat-value"><%= exams.filter(e => e.exam_type === 'final').length %></div>
      <div class="stat-delta up">▲ Major assessments</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon pink">📅</div>
    <div style="flex:1">
      <div class="stat-label">Upcoming</div>
      <div class="stat-value"><%= exams.filter(e => new Date(e.exam_date) >= new Date()).length %></div>
      <div class="stat-delta up">▲ Scheduled ahead</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Examinations List</div>
      <div class="text-xs text-muted"><%= exams.length %> exams created</div>
    </div>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Exam Name</th><th>Type</th><th>Class</th><th>Subject</th><th>Marks</th><th>Date</th><th>Results</th><th></th></tr></thead>
      <tbody>
        <% if (!exams.length) { %>
          <tr><td colspan="8"><div class="empty"><div class="empty-icon">📝</div><div class="empty-title">No exams yet</div><div class="empty-sub">Create your first exam using the button above.</div></div></td></tr>
        <% } %>
        <% exams.forEach(e => { %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <div class="stat-icon brand" style="width:32px;height:32px;font-size:14px"><%= typeIcon[e.exam_type] || '📝' %></div>
                <strong><%= e.name %></strong>
              </div>
            </td>
            <td><span class="badge badge-<%= typeBadge[e.exam_type] || 'neutral' %>"><%= e.exam_type %></span></td>
            <td><%= e.class_name %></td>
            <td><%= e.subject_name %><div class="text-xs text-muted"><%= e.subject_code %></div></td>
            <td><strong><%= e.total_marks %></strong> <span class="text-xs text-muted">(pass <%= e.passing_marks %>)</span></td>
            <td><%= helpers.formatDate(e.exam_date) %></td>
            <td><span class="badge badge-info"><%= e.results_count %> results</span></td>
            <td><a class="btn btn-primary btn-sm" href="/teacher/examinations/<%= e.id %>">Manage Results →</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Create Exam Modal -->
<div class="modal-overlay hidden" id="createExamModal" style="display:none">
  <div class="modal modal-lg">
    <div class="modal-header">
      <div class="modal-title">➕ Create New Exam</div>
      <button class="icon-btn" onclick="document.getElementById('createExamModal').style.display='none'">×</button>
    </div>
    <form id="createExamForm" onsubmit="submitExam(event)">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Exam Name <span class="req">*</span></label>
          <input class="form-control" name="name" placeholder="e.g. Midterm Examination 2026" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Exam Type <span class="req">*</span></label>
            <select class="form-select" name="exam_type" required>
              <option value="midterm">Midterm</option>
              <option value="final">Final</option>
              <option value="quiz">Quiz</option>
              <option value="assignment">Assignment</option>
              <option value="practical">Practical</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Class & Subject <span class="req">*</span></label>
            <select class="form-select" name="class_subject" required>
              <% myClasses.forEach(c => { %>
                <option value="<%= c.id %>|<%= c.subject_id %>"><%= c.name %> — <%= c.subject_code %> <%= c.subject_name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Total Marks <span class="req">*</span></label>
            <input class="form-control" type="number" name="total_marks" value="100" min="1" required>
          </div>
          <div class="form-group">
            <label class="form-label">Passing Marks <span class="req">*</span></label>
            <input class="form-control" type="number" name="passing_marks" value="40" min="0" required>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Exam Date <span class="req">*</span></label>
          <input class="form-control" type="date" name="exam_date" required>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('createExamModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Exam</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openCreateExam() {
    document.getElementById('createExamModal').style.display = 'flex';
  }
  async function submitExam(e) {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);
    const cs = fd.get('class_subject').split('|');
    const body = {
      name: fd.get('name'),
      exam_type: fd.get('exam_type'),
      class_id: parseInt(cs[0]),
      subject_id: parseInt(cs[1]),
      total_marks: parseInt(fd.get('total_marks')),
      passing_marks: parseInt(fd.get('passing_marks')),
      exam_date: fd.get('exam_date')
    };
    try {
      const res = await ERP.api('/api/teacher/examinations', { method: 'POST', body });
      ERP.toast('Exam Created', res.message || 'Exam created successfully.', 'success');
      setTimeout(() => location.reload(), 800);
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
  }
</script>
<%- include('../partials/layout-bottom') %>
