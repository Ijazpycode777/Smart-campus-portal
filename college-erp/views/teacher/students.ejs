<%- include('../partials/layout-top') %>
<%
  function attPct(s) {
    if (!s.att_count) return 0;
    return Math.round((s.present_count / s.att_count) * 100);
  }
  const totalStudents = students.length;
  const avgPct = totalStudents ? Math.round(students.reduce((a, s) => a + attPct(s), 0) / totalStudents) : 0;
  const atRisk = students.filter(s => attPct(s) < 50).length;
  const good = students.filter(s => attPct(s) >= 75).length;
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/teacher">Dashboard</a> / My Students</div>
    <h1>My Students</h1>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body" style="padding:14px 18px">
    <form method="GET" style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end">
      <div class="form-group" style="margin:0">
        <label class="form-label">Search</label>
        <input class="form-control" type="text" name="q" value="<%= q %>" placeholder="Search by name, roll number or email">
      </div>
      <button class="btn btn-primary" type="submit">🔍 Search</button>
    </form>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">👥</div>
    <div style="flex:1">
      <div class="stat-label">Total Students</div>
      <div class="stat-value"><%= totalStudents %></div>
      <div class="stat-delta up">▲ Across your classes</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">📊</div>
    <div style="flex:1">
      <div class="stat-label">Avg Attendance</div>
      <div class="stat-value"><%= avgPct %>%</div>
      <div class="stat-delta up">▲ Across all students</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">✅</div>
    <div style="flex:1">
      <div class="stat-label">Good Standing</div>
      <div class="stat-value"><%= good %></div>
      <div class="stat-delta up">▲ ≥ 75% attendance</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon red">⚠️</div>
    <div style="flex:1">
      <div class="stat-label">At Risk</div>
      <div class="stat-value"><%= atRisk %></div>
      <div class="stat-delta down">▼ Below 50% attendance</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Student List</div>
      <div class="text-xs text-muted"><%= students.length %> students found<% if (q) { %> for "<%= q %>"<% } %></div>
    </div>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Roll No</th><th>Student</th><th>Email</th><th>Class</th><th>Attendance</th><th>Status</th></tr></thead>
      <tbody>
        <% if (!students.length) { %>
          <tr><td colspan="6"><div class="empty"><div class="empty-icon">🎓</div><div class="empty-title">No students found</div><div class="empty-sub">Try adjusting your search.</div></div></td></tr>
        <% } %>
        <% students.forEach(s => { const p = attPct(s); %>
          <tr>
            <td><strong><%= s.roll_number %></strong></td>
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <div class="avatar avatar-sm" style="background:<%= s.avatar_color %>"><%= helpers.initials(s.full_name) %></div>
                <div style="font-weight:600"><%= s.full_name %></div>
              </div>
            </td>
            <td class="text-muted text-sm"><%= s.email %></td>
            <td><span class="badge badge-neutral"><%= s.class_name || '—' %></span></td>
            <td>
              <div style="display:flex;align-items:center;gap:8px">
                <div style="width:60px;height:6px;background:var(--surface-2);border-radius:3px;overflow:hidden">
                  <div style="width:<%= p %>%;height:100%;background:<%= p >= 75 ? '#10b981' : p >= 50 ? '#f59e0b' : '#ef4444' %>"></div>
                </div>
                <span class="text-xs text-muted"><%= s.present_count %>/<%= s.att_count %></span>
              </div>
            </td>
            <td><span class="badge <%= p >= 75 ? 'badge-success' : p >= 50 ? 'badge-warning' : 'badge-danger' %>"><%= p %>%</span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/layout-bottom') %>
