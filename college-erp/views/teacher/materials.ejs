<%- include('../partials/layout-top') %>
<%
  const typeIcon = { document: '📄', video: '🎬', link: '🔗', assignment: '📝' };
  const typeColor = { document: 'blue', video: 'purple', link: 'green', assignment: 'amber' };
  function fmtSize(bytes) {
    if (!bytes) return '—';
    const kb = bytes / 1024;
    if (kb < 1024) return Math.round(kb) + ' KB';
    return (kb / 1024).toFixed(1) + ' MB';
  }
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/teacher">Dashboard</a> / Materials</div>
    <h1>Study Materials</h1>
  </div>
  <button class="btn btn-primary" onclick="openUploadMaterial()">📤 Upload Material</button>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📦</div>
    <div style="flex:1">
      <div class="stat-label">Total Materials</div>
      <div class="stat-value"><%= materials.length %></div>
      <div class="stat-delta up">▲ Uploaded by you</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">📄</div>
    <div style="flex:1">
      <div class="stat-label">Documents</div>
      <div class="stat-value"><%= materials.filter(m => m.material_type === 'document').length %></div>
      <div class="stat-delta up">▲ PDF / Doc files</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon violet">🎬</div>
    <div style="flex:1">
      <div class="stat-label">Videos</div>
      <div class="stat-value"><%= materials.filter(m => m.material_type === 'video').length %></div>
      <div class="stat-delta up">▲ Recorded lectures</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon amber">🔗</div>
    <div style="flex:1">
      <div class="stat-label">Links</div>
      <div class="stat-value"><%= materials.filter(m => m.material_type === 'link').length %></div>
      <div class="stat-delta up">▲ External resources</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">All Materials</div>
      <div class="text-xs text-muted"><%= materials.length %> materials uploaded</div>
    </div>
  </div>
  <div class="card-body">
    <% if (!materials.length) { %>
      <div class="empty"><div class="empty-icon">📦</div><div class="empty-title">No materials uploaded</div><div class="empty-sub">Upload your first study material using the button above.</div></div>
    <% } else { %>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
        <% materials.forEach(m => { %>
          <div class="stat-card" style="display:block;padding:18px">
            <div style="display:flex;align-items:flex-start;gap:12px">
              <div class="stat-icon <%= typeColor[m.material_type] || 'brand' %>" style="width:42px;height:42px;font-size:20px"><%= typeIcon[m.material_type] || '📦' %></div>
              <div style="flex:1;min-width:0">
                <div style="font-weight:800;font-size:14px" class="truncate"><%= m.title %></div>
                <div class="text-xs text-muted truncate" style="margin-top:2px"><%= m.subject_code %> · <%= m.class_name %></div>
              </div>
            </div>
            <div style="font-size:12px;color:var(--gray-600);margin:12px 0;line-height:1.5"><%= (m.description || 'No description').slice(0, 110) %><% if ((m.description||'').length > 110) { %>…<% } %></div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin:10px 0">
              <span class="badge badge-<%= typeColor[m.material_type] || 'neutral' %>"><%= m.material_type %></span>
              <span class="badge badge-neutral">💾 <%= fmtSize(m.file_size) %></span>
            </div>
            <div class="text-xs text-muted" style="margin-bottom:10px">Uploaded <%= helpers.timeAgo(m.created_at) %></div>
            <div style="display:flex;gap:6px;border-top:1px solid var(--border);padding-top:12px">
              <% if (m.file_url) { %>
                <a href="<%= m.file_url %>" target="_blank" class="btn btn-primary btn-sm" style="flex:1">📖 Open</a>
              <% } %>
              <button class="btn btn-ghost btn-sm" onclick="deleteMaterial(<%= m.id %>, '<%= m.title.replace(/'/g, "\\'") %>')" style="color:var(--danger)">🗑 Delete</button>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- Upload Material Modal -->
<div class="modal-overlay hidden" id="uploadMaterialModal" style="display:none">
  <div class="modal modal-lg">
    <div class="modal-header">
      <div class="modal-title">📤 Upload Study Material</div>
      <button class="icon-btn" onclick="document.getElementById('uploadMaterialModal').style.display='none'">×</button>
    </div>
    <form id="uploadMaterialForm" onsubmit="submitMaterial(event)">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Title <span class="req">*</span></label>
          <input class="form-control" name="title" placeholder="e.g. Database Normalization Notes" required>
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <textarea class="form-textarea" name="description" rows="3" placeholder="Brief description of the material"></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Class & Subject <span class="req">*</span></label>
            <select class="form-select" name="class_subject" required>
              <% myClasses.forEach(c => { %>
                <option value="<%= c.id %>|<%= c.subject_id %>"><%= c.name %> — <%= c.subject_code %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Material Type <span class="req">*</span></label>
            <select class="form-select" name="material_type" required>
              <option value="document">📄 Document</option>
              <option value="video">🎬 Video</option>
              <option value="link">🔗 Link</option>
              <option value="assignment">📝 Assignment</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">File URL <span class="req">*</span></label>
          <input class="form-control" name="file_url" placeholder="https://... or path to file" required>
          <div class="form-hint">Paste a URL to the file or external resource</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('uploadMaterialModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Upload Material</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openUploadMaterial() { document.getElementById('uploadMaterialModal').style.display = 'flex'; }
  async function submitMaterial(e) {
    e.preventDefault();
    const fd = new FormData(e.target);
    const cs = fd.get('class_subject').split('|');
    const body = {
      title: fd.get('title'),
      description: fd.get('description'),
      class_id: parseInt(cs[0]),
      subject_id: parseInt(cs[1]),
      material_type: fd.get('material_type'),
      file_url: fd.get('file_url')
    };
    try {
      const res = await ERP.api('/api/teacher/materials', { method: 'POST', body });
      ERP.toast('Uploaded', res.message || 'Material uploaded successfully.', 'success');
      setTimeout(() => location.reload(), 800);
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
  }
  function deleteMaterial(id, title) {
    ERP.confirmDialog('Delete Material', `Are you sure you want to delete "${title}"? This cannot be undone.`, async () => {
      try {
        const res = await ERP.api('/api/teacher/materials/' + id, { method: 'DELETE' });
        ERP.toast('Deleted', res.message || 'Material deleted.', 'success');
        setTimeout(() => location.reload(), 800);
      } catch (err) { ERP.toast('Error', err.message, 'error'); }
    }, { confirmText: 'Delete', danger: true });
  }
</script>
<%- include('../partials/layout-bottom') %>
