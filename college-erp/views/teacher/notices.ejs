<%- include('../partials/layout-top') %>
<%
  const pinned = notices.filter(n => n.is_pinned);
  const others = notices.filter(n => !n.is_pinned);
  const categories = Array.from(new Set(notices.map(n => n.category).filter(Boolean)));
  function priBadge(p) {
    if (p === 'urgent') return '<span class="badge badge-danger">URGENT</span>';
    if (p === 'high') return '<span class="badge badge-warning">HIGH</span>';
    if (p === 'normal') return '<span class="badge badge-info">NORMAL</span>';
    return '<span class="badge badge-neutral">' + (p || 'NORMAL') + '</span>';
  }
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/teacher">Dashboard</a> / Notices</div>
    <h1>Notices & Announcements</h1>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📢</div>
    <div style="flex:1">
      <div class="stat-label">Total Notices</div>
      <div class="stat-value"><%= notices.length %></div>
      <div class="stat-delta up">▲ Visible to you</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon red">🚨</div>
    <div style="flex:1">
      <div class="stat-label">Urgent</div>
      <div class="stat-value"><%= notices.filter(n => n.priority === 'urgent').length %></div>
      <div class="stat-delta up">▲ Need attention</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">📌</div>
    <div style="flex:1">
      <div class="stat-label">Pinned</div>
      <div class="stat-value"><%= pinned.length %></div>
      <div class="stat-delta up">▲ Important</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon green">🗂️</div>
    <div style="flex:1">
      <div class="stat-label">Categories</div>
      <div class="stat-value"><%= categories.length %></div>
      <div class="stat-delta up">▲ Distinct types</div>
    </div>
  </div>
</div>

<% if (categories.length) { %>
  <div class="card mb-4">
    <div class="card-body" style="padding:14px 18px">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span class="text-xs text-muted" style="margin-right:6px">Filter:</span>
        <button class="btn btn-primary btn-sm filter-pill active" data-cat="all">All</button>
        <% categories.forEach(c => { %>
          <button class="btn btn-ghost btn-sm filter-pill" data-cat="<%= c %>"><%= c %></button>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header">
    <div class="card-title">All Notices</div>
  </div>
  <div class="card-body" style="padding:0">
    <% if (!notices.length) { %>
      <div class="empty"><div class="empty-icon">📢</div><div class="empty-title">No notices yet</div><div class="empty-sub">Notices and announcements will appear here.</div></div>
    <% } else { %>
      <div style="max-height:680px;overflow-y:auto">
        <% [ ...pinned, ...others ].forEach(n => { %>
          <div class="notice-item" data-cat="<%= n.category %>" style="padding:18px 20px;border-bottom:1px solid var(--border)<%= n.is_pinned ? ';background:linear-gradient(90deg,rgba(245,158,11,.06),transparent)' : '' %>">
            <div style="display:flex;align-items:flex-start;gap:12px">
              <% if (n.is_pinned) { %><span style="font-size:18px">📌</span><% } else { %><span style="font-size:18px">📢</span><% } %>
              <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px">
                  <strong style="font-size:15px"><%- priBadge(n.priority) %></strong>
                  <% if (n.category) { %><span class="badge badge-purple"><%= n.category %></span><% } %>
                  <% if (n.target_audience) { %><span class="badge badge-neutral">To: <%= n.target_audience %></span><% } %>
                </div>
                <div style="font-size:14px;font-weight:700;color:var(--gray-900)"><%= n.title %></div>
                <div style="font-size:13px;color:var(--gray-600);margin-top:6px;line-height:1.6"><%= n.content %></div>
                <div class="text-xs text-muted" style="margin-top:8px">Posted by <%= n.posted_by_name || 'System' %> · <%= helpers.timeAgo(n.created_at) %></div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.querySelectorAll('.filter-pill').forEach(p => {
    p.addEventListener('click', () => {
      document.querySelectorAll('.filter-pill').forEach(x => { x.classList.remove('active'); x.classList.add('btn-ghost'); x.classList.remove('btn-primary'); });
      p.classList.add('active'); p.classList.remove('btn-ghost'); p.classList.add('btn-primary');
      const cat = p.getAttribute('data-cat');
      document.querySelectorAll('.notice-item').forEach(it => {
        it.style.display = (cat === 'all' || it.getAttribute('data-cat') === cat) ? '' : 'none';
      });
    });
  });
</script>
<%- include('../partials/layout-bottom') %>
