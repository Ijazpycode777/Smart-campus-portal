<%- include('../partials/layout-top') %>
<%
  const graded = students.filter(s => s.marks_obtained !== null && s.marks_obtained !== undefined);
  const passed = graded.filter(s => s.marks_obtained >= exam.passing_marks).length;
  const avg = graded.length ? Math.round(graded.reduce((a, s) => a + (s.marks_obtained || 0), 0) / graded.length) : 0;
  const passRate = graded.length ? Math.round(passed / graded.length * 100) : 0;
  const typeBadge = { midterm: 'info', final: 'danger', quiz: 'warning', assignment: 'purple', practical: 'success' };
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/teacher">Dashboard</a> / <a href="/teacher/examinations">Examinations</a> / <%= exam.name %></div>
    <h1><%= exam.name %></h1>
  </div>
  <a href="/teacher/examinations" class="btn btn-ghost">← Back</a>
</div>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Exam Detail</div>
    <h1><%= exam.name %></h1>
    <p><span class="badge badge-<%= typeBadge[exam.exam_type] || 'neutral' %>"><%= exam.exam_type %></span> <%= exam.class_name %> · <%= exam.subject_name %> (<%= exam.subject_code %>)</p>
    <div style="display:flex;gap:24px;flex-wrap:wrap;margin-top:10px">
      <div><div class="text-xs" style="opacity:.85">Total Marks</div><div style="font-weight:800;font-size:16px"><%= exam.total_marks %></div></div>
      <div><div class="text-xs" style="opacity:.85">Passing Marks</div><div style="font-weight:800;font-size:16px"><%= exam.passing_marks %></div></div>
      <div><div class="text-xs" style="opacity:.85">Exam Date</div><div style="font-weight:800;font-size:16px"><%= helpers.formatDate(exam.exam_date) %></div></div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">👥</div>
    <div style="flex:1">
      <div class="stat-label">Total Students</div>
      <div class="stat-value"><%= students.length %></div>
      <div class="stat-delta up">▲ In this exam</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">📊</div>
    <div style="flex:1">
      <div class="stat-label">Class Average</div>
      <div class="stat-value"><%= avg %></div>
      <div class="stat-delta up">▲ Out of <%= exam.total_marks %></div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">🎯</div>
    <div style="flex:1">
      <div class="stat-label">Pass Rate</div>
      <div class="stat-value"><%= passRate %>%</div>
      <div class="stat-delta up">▲ <%= passed %>/<%= graded.length %> passed</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon pink">✅</div>
    <div style="flex:1">
      <div class="stat-label">Results Recorded</div>
      <div class="stat-value"><%= graded.length %></div>
      <div class="stat-delta up">▲ Of <%= students.length %></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Enter Results</div>
      <div class="text-xs text-muted">Update marks and remarks for each student, then save</div>
    </div>
    <button class="btn btn-primary" onclick="saveResults()">💾 Save All Results</button>
  </div>
  <div class="card-body">
    <% if (!students.length) { %>
      <div class="empty"><div class="empty-icon">🎓</div><div class="empty-title">No students in this class</div></div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Roll No</th><th>Student</th><th>Marks Obtained</th><th>Grade</th><th>Remarks</th></tr></thead>
          <tbody>
            <% students.forEach(s => { %>
              <tr>
                <td><strong><%= s.roll_number %></strong></td>
                <td>
                  <div style="display:flex;align-items:center;gap:10px">
                    <div class="avatar avatar-sm" style="background:<%= s.avatar_color %>"><%= helpers.initials(s.full_name) %></div>
                    <div style="font-weight:600"><%= s.full_name %></div>
                  </div>
                </td>
                <td style="min-width:160px">
                  <input type="number" class="form-control" min="0" max="<%= exam.total_marks %>"
                         data-student="<%= s.id %>" data-marks
                         value="<%= s.marks_obtained !== null && s.marks_obtained !== undefined ? s.marks_obtained : '' %>"
                         oninput="updateGrade(this)"
                         placeholder="0 - <%= exam.total_marks %>">
                </td>
                <td><span class="badge badge-neutral" data-grade="<%= s.id %>"><%= s.grade || '—' %></span></td>
                <td style="min-width:220px">
                  <textarea class="form-textarea" data-remarks="<%= s.id %>" rows="1" placeholder="Optional remarks"><%= s.remarks || '' %></textarea>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div style="display:flex;justify-content:flex-end;margin-top:16px">
        <button class="btn btn-primary" onclick="saveResults()">💾 Save All Results</button>
      </div>
    <% } %>
  </div>
</div>

<script>
  const totalMarks = <%= exam.total_marks %>;
  const passingMarks = <%= exam.passing_marks %>;
  function gradeFor(marks) {
    if (marks === '' || marks === null || isNaN(marks)) return '—';
    const m = parseFloat(marks);
    const pct = (m / totalMarks) * 100;
    if (pct >= 90) return 'A+';
    if (pct >= 80) return 'A';
    if (pct >= 70) return 'B+';
    if (pct >= 60) return 'B';
    if (pct >= 50) return 'C';
    if (pct >= passingMarks) return 'D';
    return 'F';
  }
  function updateGrade(input) {
    const sid = input.getAttribute('data-student');
    const badge = document.querySelector(`[data-grade="${sid}"]`);
    const g = gradeFor(input.value);
    badge.textContent = g;
    badge.className = 'badge ' + (
      g === 'A+' || g === 'A' ? 'badge-success' :
      g === 'B+' || g === 'B' ? 'badge-info' :
      g === 'C' ? 'badge-warning' :
      g === 'D' ? 'badge-purple' :
      g === 'F' ? 'badge-danger' : 'badge-neutral'
    );
  }
  document.querySelectorAll('[data-marks]').forEach(i => updateGrade(i));
  async function saveResults() {
    const results = [];
    document.querySelectorAll('[data-marks]').forEach(input => {
      const sid = parseInt(input.getAttribute('data-student'));
      const remarksEl = document.querySelector(`[data-remarks="${sid}"]`);
      results.push({
        student_id: sid,
        marks_obtained: input.value === '' ? null : parseFloat(input.value),
        remarks: remarksEl ? remarksEl.value : ''
      });
    });
    try {
      const res = await ERP.api('/api/teacher/examinations/<%= exam.id %>/results', { method: 'POST', body: { results } });
      ERP.toast('Saved', res.message || 'Results saved successfully.', 'success');
      setTimeout(() => location.reload(), 900);
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
  }
</script>
<%- include('../partials/layout-bottom') %>
