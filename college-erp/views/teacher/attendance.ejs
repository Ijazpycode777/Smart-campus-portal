<%- include('../partials/layout-top') %>
<%
  const selected = classId && subjectId;
  const present = students.filter(s => s.status === 'present').length;
  const absent = students.filter(s => s.status === 'absent').length;
  const late = students.filter(s => s.status === 'late').length;
  const excused = students.filter(s => s.status === 'excused').length;
  const statusColor = { present: 'success', absent: 'danger', late: 'warning', excused: 'info' };
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/teacher">Dashboard</a> / Attendance</div>
    <h1>Attendance</h1>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body" style="padding:14px 18px">
    <form method="GET" style="display:grid;grid-template-columns:1.4fr 1.4fr 1fr auto;gap:10px;align-items:end">
      <div class="form-group" style="margin:0">
        <label class="form-label">Class</label>
        <select class="form-select" name="class_id">
          <option value="">Select class</option>
          <% myClasses.forEach(c => { %><option value="<%= c.id %>" <%= String(classId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group" style="margin:0">
        <label class="form-label">Subject</label>
        <select class="form-select" name="subject_id">
          <option value="">Select subject</option>
          <% myClasses.forEach(c => { %><option value="<%= c.subject_id %>" <%= String(subjectId) === String(c.subject_id) ? 'selected' : '' %>><%= c.subject_code %> — <%= c.subject_name %></option><% }) %>
        </select>
      </div>
      <div class="form-group" style="margin:0">
        <label class="form-label">Date</label>
        <input class="form-control" type="date" name="date" value="<%= date %>">
      </div>
      <button class="btn btn-primary" type="submit">🔍 Load</button>
    </form>
  </div>
</div>

<% if (selected) { %>
  <div class="stats-grid">
    <div class="stat-card slide-up">
      <div class="stat-icon brand">👥</div>
      <div style="flex:1">
        <div class="stat-label">Total Students</div>
        <div class="stat-value"><%= students.length %></div>
        <div class="stat-delta up">▲ Loaded roster</div>
      </div>
    </div>
    <div class="stat-card slide-up" style="animation-delay:.05s">
      <div class="stat-icon green">✅</div>
      <div style="flex:1">
        <div class="stat-label">Present</div>
        <div class="stat-value"><%= present %></div>
        <div class="stat-delta up">▲ Marked present</div>
      </div>
    </div>
    <div class="stat-card slide-up" style="animation-delay:.1s">
      <div class="stat-icon red">❌</div>
      <div style="flex:1">
        <div class="stat-label">Absent</div>
        <div class="stat-value"><%= absent %></div>
        <div class="stat-delta down">▼ Not in class</div>
      </div>
    </div>
    <div class="stat-card slide-up" style="animation-delay:.15s">
      <div class="stat-icon amber">⏰</div>
      <div style="flex:1">
        <div class="stat-label">Late</div>
        <div class="stat-value"><%= late %></div>
        <div class="stat-delta up">▲ Late arrivals</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">Mark Attendance</div>
        <div class="text-xs text-muted"><%= helpers.formatDate(date) %> · Choose a status for each student</div>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <button type="button" class="btn btn-ghost btn-sm" onclick="markAll('present')">All Present</button>
        <button type="button" class="btn btn-ghost btn-sm" onclick="markAll('absent')">All Absent</button>
      </div>
    </div>
    <div class="card-body">
      <% if (!students.length) { %>
        <div class="empty"><div class="empty-icon">🎓</div><div class="empty-title">No students found</div><div class="empty-sub">This class has no enrolled students.</div></div>
      <% } else { %>
        <form id="attendanceForm">
          <div class="table-wrap">
            <table class="data-table">
              <thead><tr><th>Roll</th><th>Student</th><th>Status</th></tr></thead>
              <tbody>
                <% students.forEach(s => { %>
                  <tr>
                    <td><strong><%= s.roll_number %></strong></td>
                    <td>
                      <div style="display:flex;align-items:center;gap:10px">
                        <div class="avatar avatar-sm" style="background:<%= s.avatar_color %>"><%= helpers.initials(s.full_name) %></div>
                        <div style="font-weight:600"><%= s.full_name %></div>
                      </div>
                    </td>
                    <td>
                      <div class="att-radio" data-student="<%= s.id %>" style="display:inline-flex;gap:4px;background:var(--surface-2);padding:3px;border-radius:8px">
                        <% ['present','absent','late','excused'].forEach(st => { %>
                          <label class="att-opt att-<%= st %> <%= s.status === st ? 'active' : '' %>" style="padding:6px 10px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;user-select:none;border:1px solid transparent">
                            <input type="radio" name="status_<%= s.id %>" value="<%= st %>" <%= s.status === st ? 'checked' : '' %> style="display:none">
                            <%= st.charAt(0).toUpperCase() + st.slice(1) %>
                          </label>
                        <% }) %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div style="display:flex;justify-content:flex-end;margin-top:16px;gap:8px">
            <button type="button" class="btn btn-ghost" onclick="location.reload()">Reset</button>
            <button type="button" class="btn btn-primary" onclick="saveAttendance()">💾 Save Attendance</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>

  <style>
    .att-opt.active { color: #fff !important; }
    .att-present.active { background: #10b981; }
    .att-absent.active { background: #ef4444; }
    .att-late.active { background: #f59e0b; color: #1f2937 !important; }
    .att-excused.active { background: #3b82f6; }
  </style>
<% } else { %>
  <div class="card">
    <div class="card-body">
      <div class="empty"><div class="empty-icon">📋</div><div class="empty-title">Select a class and subject</div><div class="empty-sub">Use the filters above to load the student roster for attendance.</div></div>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header">
    <div class="card-title">Recent Sessions</div>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Date</th><th>Class</th><th>Subject</th><th>Total</th><th>Present</th><th>Absent</th><th>Rate</th><th></th></tr></thead>
      <tbody>
        <% if (!recentSessions.length) { %>
          <tr><td colspan="8"><div class="empty"><div class="empty-title">No recent sessions</div></div></td></tr>
        <% } %>
        <% recentSessions.forEach(r => {
          const pct = r.total ? Math.round(r.present / r.total * 100) : 0;
        %>
          <tr>
            <td><strong><%= helpers.formatDate(r.date) %></strong></td>
            <td><%= r.class_name %></td>
            <td><%= r.subject_name %><div class="text-xs text-muted"><%= r.subject_code %></div></td>
            <td><%= r.total %></td>
            <td><span class="badge badge-success"><%= r.present %></span></td>
            <td><span class="badge badge-danger"><%= r.absent %></span></td>
            <td><span class="badge <%= pct >= 75 ? 'badge-success' : pct >= 50 ? 'badge-warning' : 'badge-danger' %>"><%= pct %>%</span></td>
            <td><a class="btn btn-ghost btn-sm" href="/teacher/attendance?class_id=<%= r.class_id %>&subject_id=<%= r.subject_id %>&date=<%= r.date %>">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll('.att-radio').forEach(group => {
    group.querySelectorAll('.att-opt').forEach(opt => {
      opt.addEventListener('click', () => {
        group.querySelectorAll('.att-opt').forEach(o => o.classList.remove('active'));
        opt.classList.add('active');
        opt.querySelector('input').checked = true;
      });
    });
  });
  function markAll(status) {
    document.querySelectorAll('.att-radio').forEach(group => {
      group.querySelectorAll('.att-opt').forEach(opt => {
        opt.classList.toggle('active', opt.classList.contains('att-' + status));
        opt.querySelector('input').checked = opt.classList.contains('att-' + status);
      });
    });
  }
  async function saveAttendance() {
    const records = [];
    document.querySelectorAll('.att-radio').forEach(group => {
      const sid = group.getAttribute('data-student');
      const checked = group.querySelector('input:checked');
      if (checked) records.push({ student_id: parseInt(sid), status: checked.value });
    });
    if (!records.length) { ERP.toast('Empty', 'No students to save.', 'warning'); return; }
    try {
      const res = await ERP.api('/api/teacher/attendance', {
        method: 'POST',
        body: { class_id: <%= classId %>, subject_id: <%= subjectId %>, date: '<%= date %>', records }
      });
      ERP.toast('Saved', res.message || 'Attendance recorded successfully.', 'success');
      setTimeout(() => location.reload(), 900);
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
  }
</script>
<%- include('../partials/layout-bottom') %>
