<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
  <title>Sign In — <%= collegeName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%236366f1'/><text x='50' y='68' font-size='58' font-family='Arial' font-weight='bold' fill='white' text-anchor='middle'>N</text></svg>">
</head>
<body>
  <div class="login-shell">
    <!-- Left: art -->
    <div class="login-art">
      <div class="art-content">
        <div class="art-logo">
          <div class="logo">N</div>
          <div>
            <div style="font-size:16px;font-weight:800;color:#fff"><%= collegeName %></div>
            <div style="font-size:11px;color:rgba(255,255,255,.7);text-transform:uppercase;letter-spacing:.08em">College Management ERP</div>
          </div>
        </div>
        <h1>One platform. <span class="grad">Three portals.</span><br>Infinite possibilities.</h1>
        <p class="art-sub">A modern, unified ERP that connects administrators, faculty and students — streamlining academics, attendance, examinations, fees and communication across your entire institution.</p>

        <div class="art-features">
          <div class="art-feature">
            <div class="feat-icon">🛡️</div>
            <div>
              <div class="feat-title">Role-Based Access</div>
              <div class="feat-sub">Secure, granular permissions</div>
            </div>
          </div>
          <div class="art-feature">
            <div class="feat-icon">📊</div>
            <div>
              <div class="feat-title">Live Analytics</div>
              <div class="feat-sub">Real-time institutional insights</div>
            </div>
          </div>
          <div class="art-feature">
            <div class="feat-icon">🎯</div>
            <div>
              <div class="feat-title">Academic Tracking</div>
              <div class="feat-sub">Attendance, grades, materials</div>
            </div>
          </div>
          <div class="art-feature">
            <div class="feat-icon">🔔</div>
            <div>
              <div class="feat-title">Smart Notifications</div>
              <div class="feat-sub">Stay informed, always</div>
            </div>
          </div>
        </div>
      </div>
      <div class="art-footer">© <%= new Date().getFullYear() %> <%= collegeName %>. All rights reserved. Premium ERP v1.0</div>
    </div>

    <!-- Right: form -->
    <div class="login-form-side">
      <div class="login-card">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:32px">
          <div style="width:44px;height:44px;border-radius:12px;background:var(--gradient-brand);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:18px;box-shadow:0 6px 16px rgba(99,102,241,.4)">N</div>
          <div>
            <div style="font-weight:700;color:var(--gray-900)"><%= collegeName %></div>
            <div style="font-size:11px;color:var(--gray-500);text-transform:uppercase;letter-spacing:.08em">Sign in to continue</div>
          </div>
        </div>

        <h1 class="login-title">Welcome back 👋</h1>
        <p class="login-sub">Enter your credentials to access your portal.</p>

        <% if (error) { %>
          <div class="alert alert-error"><span>⛔</span> <div><%= error %></div></div>
        <% } %>

        <form action="/login" method="POST" id="loginForm">
          <% if (redirect) { %><input type="hidden" name="redirect" value="<%= redirect %>"><% } %>
          <div class="form-group">
            <label class="form-label">Username or Email <span class="req">*</span></label>
            <input class="form-control" type="text" name="username" placeholder="e.g. admin or you@college.edu" required autofocus>
          </div>
          <div class="form-group">
            <label class="form-label" style="display:flex;justify-content:space-between">Password <span class="req">*</span>
              <a href="#" style="text-transform:none;letter-spacing:0;color:var(--brand-600);font-weight:600;font-size:11px">Forgot?</a>
            </label>
            <div style="position:relative">
              <input class="form-control" type="password" name="password" id="password" placeholder="Enter your password" required>
              <button type="button" id="togglePw" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:transparent;border:0;cursor:pointer;color:var(--gray-400);padding:6px">👁️</button>
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
            <label style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--gray-600);cursor:pointer">
              <input type="checkbox" name="remember" style="width:14px;height:14px;accent-color:var(--brand-600)"> Remember me
            </label>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block">Sign In →</button>
        </form>

        <div class="demo-creds">
          <div class="demo-title">🔑 Demo Credentials</div>
          <div class="demo-row"><span>👑 Admin</span> <code>admin / admin123</code></div>
          <div class="demo-row"><span>👨‍🏫 Teacher</span> <code>prof.sharma / teacher123</code></div>
          <div class="demo-row"><span>🎓 Student</span> <code>aarav.sharma1 / student123</code></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('togglePw').addEventListener('click', function() {
      const pw = document.getElementById('password');
      pw.type = pw.type === 'password' ? 'text' : 'password';
      this.textContent = pw.type === 'password' ? '👁️' : '🙈';
    });
  </script>
</body>
</html>
