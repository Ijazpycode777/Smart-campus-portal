<%- include('../partials/layout-top') %>
<%
  const totalCourses = courses.length;
  const totalDuration = courses.reduce((a, c) => a + (c.duration_years || 0), 0);
  const totalStudents = courses.reduce((a, c) => a + (c.student_count || 0), 0);
  const totalSubjects = courses.reduce((a, c) => a + (c.subject_count || 0), 0);
  const cardColors = ['#6366f1','#ec4899','#f59e0b','#10b981','#3b82f6','#8b5cf6','#06b6d4','#f97316'];
%>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Academic Catalog</div>
    <h1>Courses & Programs</h1>
    <p>Define degree programs, their duration and semester structure, and track enrollment at a glance across <%= collegeName %>.</p>
    <div class="hero-stat">
      <div class="num"><%= totalCourses %></div>
      <div class="lbl">Active Programs</div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">🎓</div>
    <div style="flex:1">
      <div class="stat-label">Total Courses</div>
      <div class="stat-value"><%= totalCourses %></div>
      <div class="stat-delta up">▲ Across departments</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">📅</div>
    <div style="flex:1">
      <div class="stat-label">Total Duration</div>
      <div class="stat-value"><%= totalDuration %> yrs</div>
      <div class="stat-delta up">▲ Combined program length</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">👥</div>
    <div style="flex:1">
      <div class="stat-label">Total Students</div>
      <div class="stat-value"><%= totalStudents %></div>
      <div class="stat-delta up">▲ Enrolled across courses</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon pink">📚</div>
    <div style="flex:1">
      <div class="stat-label">Total Subjects</div>
      <div class="stat-value"><%= totalSubjects %></div>
      <div class="stat-delta up">▲ Mapped to courses</div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <div class="card-title">All Courses</div>
    <button class="btn btn-primary btn-sm" onclick="openAddCourse()">➕ Add Course</button>
  </div>
  <div class="card-body" style="padding:0">
    <% if (!courses.length) { %>
      <div class="empty"><div class="empty-icon">🎓</div><div class="empty-title">No courses yet</div><div class="empty-sub">Create your first degree program to begin.</div></div>
    <% } else { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;padding:20px">
        <% courses.forEach((c, i) => {
          const color = cardColors[i % cardColors.length];
          const capPct = c.student_count && c.total_capacity ? Math.min(100, Math.round(c.student_count / c.total_capacity * 100)) : 0;
        %>
          <div class="card" style="transition:all .2s">
            <div style="height:6px;background:<%= color %>;border-radius:var(--r-lg) var(--r-lg) 0 0"></div>
            <div class="card-body" style="padding:16px">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:10px">
                <div>
                  <span class="badge" style="background:<%= color %>22;color:<%= color %>;border-color:<%= color %>44;font-family:var(--font-mono)"><%= c.code %></span>
                </div>
                <span class="badge badge-neutral"><%= c.dept_code || '—' %></span>
              </div>
              <div style="font-weight:700;font-size:15px;color:var(--gray-900);margin-bottom:4px"><%= c.name %></div>
              <div class="text-xs text-muted" style="margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden"><%= c.description || 'No description provided.' %></div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
                <div style="padding:8px 10px;background:var(--surface-2);border-radius:8px">
                  <div class="text-xs text-muted">Duration</div>
                  <div style="font-weight:700;font-size:14px"><%= c.duration_years %> year(s)</div>
                </div>
                <div style="padding:8px 10px;background:var(--surface-2);border-radius:8px">
                  <div class="text-xs text-muted">Semesters</div>
                  <div style="font-weight:700;font-size:14px"><%= c.total_semesters %> sem(s)</div>
                </div>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;padding-top:10px;border-top:1px solid var(--border)">
                <div style="display:flex;gap:12px;font-size:12px">
                  <div><strong><%= c.student_count || 0 %></strong> <span class="text-muted">students</span></div>
                  <div><strong><%= c.subject_count || 0 %></strong> <span class="text-muted">subjects</span></div>
                </div>
                <button class="btn btn-ghost btn-sm" onclick='editCourse(<%- JSON.stringify(c) %>)'>✏️ Manage</button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
  const DEPARTMENTS = <%- JSON.stringify(departments) %>;
  function openAddCourse() {
    const deptOpts = `<option value="">— Not assigned —</option>` + DEPARTMENTS.map(d => `<option value="${d.id}">${d.code} — ${d.name}</option>`).join('');
    const body = `
      <div class="form-row">
        <div class="form-group"><label class="form-label">Course Code <span class="req">*</span></label><input class="form-control" name="code" placeholder="BTECH-CS" required></div>
        <div class="form-group"><label class="form-label">Course Name <span class="req">*</span></label><input class="form-control" name="name" placeholder="B.Tech Computer Science" required></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Department</label><select class="form-select" name="department_id">${deptOpts}</select></div>
        <div class="form-group"><label class="form-label">Duration (years)</label><input class="form-control" type="number" name="duration_years" min="1" max="6" value="4"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Total Semesters</label><input class="form-control" type="number" name="total_semesters" min="1" max="12" value="8"></div>
        <div class="form-group"><label class="form-label">Status</label><select class="form-select" name="is_active"><option value="1">Active</option><option value="0">Inactive</option></select></div>
      </div>
      <div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" name="description" placeholder="Brief overview of the course…"></textarea></div>
    `;
    const { close } = ERP.modal({
      title: '➕ Add New Course', body, size: 'lg',
      footer: `<button class="btn btn-ghost" id="courseCancelBtn">Cancel</button><button class="btn btn-primary" id="courseSaveBtn">Create Course</button>`
    });
    document.getElementById('courseCancelBtn').addEventListener('click', close);
    document.getElementById('courseSaveBtn').addEventListener('click', () => submitCourse(null, close));
  }
  function editCourse(c) {
    const deptOpts = `<option value="">— Not assigned —</option>` + DEPARTMENTS.map(d => `<option value="${d.id}" ${d.id == c.department_id ? 'selected' : ''}>${d.code} — ${d.name}</option>`).join('');
    const body = `
      <div class="form-row">
        <div class="form-group"><label class="form-label">Course Code</label><input class="form-control" name="code" value="${ERP.escapeHtml(c.code || '')}"></div>
        <div class="form-group"><label class="form-label">Course Name</label><input class="form-control" name="name" value="${ERP.escapeHtml(c.name || '')}"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Department</label><select class="form-select" name="department_id">${deptOpts}</select></div>
        <div class="form-group"><label class="form-label">Duration (years)</label><input class="form-control" type="number" name="duration_years" min="1" max="6" value="${c.duration_years || 4}"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Total Semesters</label><input class="form-control" type="number" name="total_semesters" min="1" max="12" value="${c.total_semesters || 8}"></div>
        <div class="form-group"><label class="form-label">Status</label><select class="form-select" name="is_active"><option value="1" ${c.is_active !== 0 ? 'selected' : ''}>Active</option><option value="0" ${c.is_active === 0 ? 'selected' : ''}>Inactive</option></select></div>
      </div>
      <div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" name="description">${ERP.escapeHtml(c.description || '')}</textarea></div>
    `;
    const { close } = ERP.modal({
      title: `✏️ Edit ${c.name}`, body, size: 'lg',
      footer: `<button class="btn btn-ghost" id="courseCancelBtn">Cancel</button><button class="btn btn-primary" id="courseSaveBtn">Save Changes</button>`
    });
    document.getElementById('courseCancelBtn').addEventListener('click', close);
    document.getElementById('courseSaveBtn').addEventListener('click', () => submitCourse(c.id, close));
  }
  async function submitCourse(id, closeFn) {
    const modalBody = document.querySelector('.modal-overlay .modal-body');
    const data = {};
    modalBody.querySelectorAll('[name]').forEach(i => { data[i.name] = i.value; });
    const url = id ? '/api/admin/courses/' + id : '/api/admin/courses';
    const method = id ? 'PUT' : 'POST';
    const btn = document.getElementById('courseSaveBtn');
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const res = await ERP.api(url, { method, body: data });
      ERP.toast('Success', res.message || (id ? 'Course updated.' : 'Course created.'), 'success');
      setTimeout(() => location.reload(), 700);
    } catch (err) {
      ERP.toast('Error', err.message || (err.status === 404 ? 'API endpoint not available yet.' : 'Request failed.'), 'error');
      btn.disabled = false; btn.textContent = id ? 'Save Changes' : 'Create Course';
    }
  }
</script>
<%- include('../partials/layout-bottom') %>
