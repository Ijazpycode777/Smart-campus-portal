<%- include('../partials/layout-top') %>
<%
  const sorted = results.slice().sort((a, b) => (b.marks_obtained || 0) - (a.marks_obtained || 0));
  const totalResults = sorted.length;
  const totalMarksSum = sorted.reduce((a, r) => a + (r.marks_obtained || 0), 0);
  const avgMarks = totalResults ? (totalMarksSum / totalResults).toFixed(1) : '0';
  const passCount = sorted.filter(r => parseFloat(r.marks_obtained) >= 40).length;
  const passRate = totalResults ? Math.round((passCount / totalResults) * 100) : 0;
  const gradeColor = (g) => {
    if (!g) return 'badge-neutral';
    const grade = g.toUpperCase();
    if (grade.startsWith('A')) return 'badge-success';
    if (grade === 'B' || grade === 'B+') return 'badge-info';
    if (grade === 'C' || grade === 'C+') return 'badge-warning';
    if (grade === 'D') return 'badge-warning';
    if (grade === 'F') return 'badge-danger';
    return 'badge-neutral';
  };
  // Grade distribution for donut
  const gradeMap = {};
  sorted.forEach(r => { if (r.grade) gradeMap[r.grade.toUpperCase()] = (gradeMap[r.grade.toUpperCase()] || 0) + 1; });
  const gradeColors = { 'A+':'#10b981', 'A':'#22c55e', 'B+':'#3b82f6', 'B':'#06b6d4', 'C+':'#f59e0b', 'C':'#f97316', 'D':'#fb923c', 'F':'#ef4444' };
  const gradeData = Object.keys(gradeMap).sort().map(g => ({ label: g, value: gradeMap[g], color: gradeColors[g] || '#6366f1' }));
  const selectedExam = exams.find(e => String(e.id) === String(selectedExamId));
%>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Academic Performance</div>
    <h1>Examination Results</h1>
    <p><% if (selectedExam) { %>Viewing <strong><%= selectedExam.name %></strong> (<%= selectedExam.class_name %> · <%= selectedExam.subject_code %>).<% } else { %>Pick an exam to view its results, rankings and grade distribution.<% } %></p>
    <div class="hero-stat">
      <div class="num"><%= passRate %>%</div>
      <div class="lbl">Pass Rate</div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body" style="padding:14px 18px">
    <form method="GET" style="display:grid;grid-template-columns:2fr auto;gap:10px;align-items:end">
      <div class="form-group" style="margin:0">
        <label class="form-label">Select Exam</label>
        <select class="form-select" name="exam_id" onchange="this.form.submit()">
          <option value="">— Choose an exam —</option>
          <% exams.forEach(e => { %>
            <option value="<%= e.id %>" <%= String(selectedExamId) === String(e.id) ? 'selected' : '' %>><%= e.name %> · <%= e.class_name %> · <%= e.subject_code %></option>
          <% }) %>
        </select>
      </div>
      <button class="btn btn-primary" type="submit">Load Results</button>
    </form>
  </div>
</div>

<% if (!selectedExamId) { %>
  <div class="card"><div class="card-body"><div class="empty"><div class="empty-icon">📊</div><div class="empty-title">No exam selected</div><div class="empty-sub">Pick an exam above to view its results.</div></div></div></div>
<% } else { %>
  <div class="stats-grid">
    <div class="stat-card slide-up">
      <div class="stat-icon brand">👥</div>
      <div style="flex:1">
        <div class="stat-label">Total Students</div>
        <div class="stat-value"><%= totalResults %></div>
        <div class="stat-delta up">▲ Appeared in exam</div>
      </div>
    </div>
    <div class="stat-card slide-up" style="animation-delay:.05s">
      <div class="stat-icon green">📈</div>
      <div style="flex:1">
        <div class="stat-label">Class Average</div>
        <div class="stat-value"><%= avgMarks %></div>
        <div class="stat-delta up">▲ Mean marks scored</div>
      </div>
    </div>
    <div class="stat-card slide-up" style="animation-delay:.1s">
      <div class="stat-icon amber">✅</div>
      <div style="flex:1">
        <div class="stat-label">Pass Rate</div>
        <div class="stat-value"><%= passRate %>%</div>
        <div class="stat-delta up">▲ <%= passCount %> of <%= totalResults %> passed</div>
      </div>
    </div>
    <div class="stat-card slide-up" style="animation-delay:.15s">
      <div class="stat-icon pink">🏆</div>
      <div style="flex:1">
        <div class="stat-label">Top Scorer</div>
        <div class="stat-value" style="font-size:18px;line-height:1.2"><% if (sorted.length) { %><%= sorted[0].marks_obtained %><% } else { %>—<% } %></div>
        <div class="stat-delta up">▲ <% if (sorted.length) { %><%= sorted[0].full_name %><% } else { %>No data<% } %></div>
      </div>
    </div>
  </div>

  <div class="charts-grid">
    <div class="card">
      <div class="card-header">
        <div>
          <div class="card-title">Rankings & Result Sheet</div>
          <div class="text-xs text-muted">Sorted by marks descending · <%= totalResults %> students</div>
        </div>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Rank</th><th>Student</th><th>Roll No</th><th>Marks</th><th>Grade</th><th>Remarks</th></tr></thead>
          <tbody>
            <% if (!sorted.length) { %>
              <tr><td colspan="6"><div class="empty"><div class="empty-icon">📭</div><div class="empty-title">No results recorded</div><div class="empty-sub">Add marks for this exam to see rankings.</div></div></td></tr>
            <% } %>
            <% sorted.forEach((r, i) => {
              const pct = r.total_marks ? Math.round((r.marks_obtained / r.total_marks) * 100) : 0;
              const rankBadge = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : (i + 1);
            %>
              <tr>
                <td><strong style="font-size:14px"><%= rankBadge %></strong></td>
                <td>
                  <div style="display:flex;align-items:center;gap:10px">
                    <div class="avatar avatar-sm" style="background:<%= r.avatar_color %>"><%= helpers.initials(r.full_name) %></div>
                    <div style="font-weight:600;color:var(--gray-900)"><%= r.full_name %></div>
                  </div>
                </td>
                <td><strong style="font-family:var(--font-mono)"><%= r.roll_number || '—' %></strong></td>
                <td>
                  <div style="display:flex;align-items:center;gap:8px">
                    <strong style="font-size:14px"><%= r.marks_obtained %></strong>
                    <span class="text-xs text-muted">/ <% if (typeof total_marks !== 'undefined') { %><%= total_marks %><% } else { %>100<% } %></span>
                    <span class="badge badge-neutral"><%= pct %>%</span>
                  </div>
                </td>
                <td><span class="badge <%= gradeColor(r.grade) %>"><%= r.grade || '—' %></span></td>
                <td class="text-muted"><%= r.remarks || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div>
          <div class="card-title">Grade Distribution</div>
          <div class="text-xs text-muted"><%= totalResults %> results across grades</div>
        </div>
      </div>
      <div class="card-body" style="text-align:center">
        <% if (gradeData.length) { %>
          <canvas data-chart="donut" data-data='<%= JSON.stringify(gradeData) %>' data-opts='<%= JSON.stringify({ centerLabel: "Results", centerValue: totalResults }) %>' style="width:100%;height:220px"></canvas>
          <div style="margin-top:16px;display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <% gradeData.forEach(g => { %>
              <div style="display:flex;align-items:center;gap:6px;font-size:12px;padding:6px 8px;background:var(--surface-2);border-radius:6px">
                <span style="width:10px;height:10px;border-radius:3px;background:<%= g.color %>"></span>
                <span style="color:var(--gray-600);font-weight:600"><%= g.label %></span>
                <span style="margin-left:auto;font-weight:700"><%= g.value %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty"><div class="empty-icon">📊</div><div class="empty-sub">No grade data available.</div></div>
        <% } %>
      </div>
    </div>
  </div>
<% } %>
<%- include('../partials/layout-bottom') %>
