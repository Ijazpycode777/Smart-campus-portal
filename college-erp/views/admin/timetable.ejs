<%- include('../partials/layout-top') %>
<%
  const DAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  // Group timetable by day then by start_time
  const byDay = {};
  DAYS.forEach(d => byDay[d] = []);
  const slots = [];
  timetable.forEach(t => {
    if (byDay[t.day_of_week]) byDay[t.day_of_week].push(t);
    const key = t.start_time + ' - ' + t.end_time;
    if (!slots.find(s => s.key === key)) slots.push({ key, start: t.start_time, end: t.end_time });
  });
  // Sort each day's entries by start time
  Object.values(byDay).forEach(arr => arr.sort((a, b) => (a.start_time || '').localeCompare(b.start_time || '')));
  slots.sort((a, b) => (a.start || '').localeCompare(b.start || ''));
  const selectedClass = classes.find(c => String(c.id) === String(classId));
  const slotColors = ['#6366f1','#ec4899','#f59e0b','#10b981','#3b82f6','#8b5cf6','#06b6d4','#f97316'];
  const totalSlots = timetable.length;
%>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Weekly Schedule</div>
    <h1>Timetable</h1>
    <p>Build and visualize the weekly class timetable for <%= selectedClass ? selectedClass.name : 'any class section' %> at <%= collegeName %>.</p>
    <% if (selectedClass) { %>
      <div class="hero-stat">
        <div class="num"><%= totalSlots %></div>
        <div class="lbl">Scheduled Slots</div>
      </div>
    <% } %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body" style="padding:14px 18px">
    <form method="GET" style="display:grid;grid-template-columns:2fr auto;gap:10px;align-items:end">
      <div class="form-group" style="margin:0">
        <label class="form-label">Select Class</label>
        <select class="form-select" name="class_id" onchange="this.form.submit()">
          <option value="">— Choose a class to view timetable —</option>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>" <%= String(classId) === String(c.id) ? 'selected' : '' %>><%= c.name %> · <%= c.course_code %> · Sem <%= c.semester %></option>
          <% }) %>
        </select>
      </div>
      <button class="btn btn-primary" type="submit">Load Timetable</button>
    </form>
  </div>
</div>

<% if (!classId) { %>
  <div class="card">
    <div class="card-body">
      <div class="empty"><div class="empty-icon">📅</div><div class="empty-title">No class selected</div><div class="empty-sub">Pick a class above to load its weekly timetable.</div></div>
    </div>
  </div>
<% } else { %>
  <div class="stats-grid">
    <div class="stat-card slide-up">
      <div class="stat-icon brand">📅</div>
      <div style="flex:1">
        <div class="stat-label">Total Slots</div>
        <div class="stat-value"><%= totalSlots %></div>
        <div class="stat-delta up">▲ Across the week</div>
      </div>
    </div>
    <div class="stat-card slide-up" style="animation-delay:.05s">
      <div class="stat-icon green">📆</div>
      <div style="flex:1">
        <div class="stat-label">Active Days</div>
        <div class="stat-value"><%= DAYS.filter(d => byDay[d].length).length %>/<%= DAYS.length %></div>
        <div class="stat-delta up">▲ Working days</div>
      </div>
    </div>
    <div class="stat-card slide-up" style="animation-delay:.1s">
      <div class="stat-icon amber">📚</div>
      <div style="flex:1">
        <div class="stat-label">Subjects Scheduled</div>
        <div class="stat-value"><%= new Set(timetable.map(t => t.subject_code)).size %></div>
        <div class="stat-delta up">▲ Unique subjects</div>
      </div>
    </div>
    <div class="stat-card slide-up" style="animation-delay:.15s">
      <div class="stat-icon pink">👨‍🏫</div>
      <div style="flex:1">
        <div class="stat-label">Teachers Involved</div>
        <div class="stat-value"><%= new Set(timetable.map(t => t.teacher_name)).size %></div>
        <div class="stat-delta up">▲ Faculty members</div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">
      <div>
        <div class="card-title">Weekly Timetable <% if (selectedClass) { %>· <%= selectedClass.name %><% } %></div>
        <div class="text-xs text-muted">Monday through Saturday · Click "Add Slot" to schedule a new period</div>
      </div>
      <button class="btn btn-primary btn-sm" onclick="openAddSlot()">➕ Add Slot</button>
    </div>
    <div class="card-body" style="padding:0;overflow-x:auto">
      <% if (!timetable.length) { %>
        <div class="empty"><div class="empty-icon">📅</div><div class="empty-title">No slots scheduled</div><div class="empty-sub">Add the first lecture slot for this class.</div></div>
      <% } else { %>
        <table class="data-table" style="min-width:900px">
          <thead>
            <tr>
              <th style="width:140px">Time</th>
              <% DAYS.forEach(d => { %><th><%= d.slice(0,3) %></th><% }) %>
            </tr>
          </thead>
          <tbody>
            <% slots.forEach(slot => { %>
              <tr>
                <td style="background:var(--surface-2);font-weight:600;font-size:12px"><%= slot.start %> - <%= slot.end %></td>
                <% DAYS.forEach((d, di) => {
                  const entry = byDay[d].find(e => e.start_time === slot.start && e.end_time === slot.end);
                  const color = entry ? slotColors[di % slotColors.length] : null;
                %>
                  <td style="vertical-align:top;padding:6px">
                    <% if (entry) { %>
                      <div style="background:<%= color %>14;border-left:3px solid <%= color %>;border-radius:6px;padding:8px;position:relative">
                        <div style="font-weight:700;font-size:12px;color:var(--gray-900);line-height:1.2"><%= entry.subject_code %></div>
                        <div class="text-xs text-muted truncate" style="margin-top:2px"><%= entry.subject_name %></div>
                        <div class="text-xs" style="color:<%= color %>;font-weight:600;margin-top:2px"><%= entry.teacher_name %></div>
                        <% if (entry.room) { %><div class="text-xs text-muted">📍 <%= entry.room %></div><% } %>
                        <button class="btn btn-ghost btn-sm" style="position:absolute;top:2px;right:2px;padding:2px 6px;color:var(--danger)" onclick="deleteSlot(<%= entry.id %>)">×</button>
                      </div>
                    <% } else { %>
                      <div style="height:60px;border:1px dashed var(--border);border-radius:6px"></div>
                    <% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">All Scheduled Slots</div>
      <span class="badge badge-info"><%= timetable.length %> entries</span>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Day</th><th>Time</th><th>Subject</th><th>Teacher</th><th>Room</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (!timetable.length) { %>
            <tr><td colspan="6"><div class="empty"><div class="empty-icon">📭</div><div class="empty-sub">No scheduled slots.</div></div></td></tr>
          <% } %>
          <% timetable.sort((a,b) => DAYS.indexOf(a.day_of_week) - DAYS.indexOf(b.day_of_week) || (a.start_time||'').localeCompare(b.start_time||'')).forEach(t => { %>
            <tr>
              <td><strong><%= t.day_of_week %></strong></td>
              <td><span class="badge badge-neutral"><%= t.start_time %> - <%= t.end_time %></span></td>
              <td><strong style="font-family:var(--font-mono)"><%= t.subject_code %></strong> <div class="text-xs text-muted"><%= t.subject_name %></div></td>
              <td><span class="badge badge-info badge-dot"><%= t.teacher_name %></span></td>
              <td><%= t.room || '—' %></td>
              <td><button class="btn btn-ghost btn-sm" style="color:var(--danger)" onclick="deleteSlot(<%= t.id %>)">🗑️ Delete</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<script>
  const SUBJECTS = <%- JSON.stringify(subjects) %>;
  const TEACHERS = <%- JSON.stringify(teachers) %>;
  const DAYS = <%- JSON.stringify(DAYS) %>;
  const CLASS_ID = '<%= classId %>';
  function openAddSlot() {
    const subjOpts = SUBJECTS.map(s => `<option value="${s.id}">${s.code} — ${s.name}</option>`).join('');
    const teacherOpts = `<option value="">— Not assigned —</option>` + TEACHERS.map(t => `<option value="${t.id}">${t.full_name}</option>`).join('');
    const dayOpts = DAYS.map(d => `<option value="${d}">${d}</option>`).join('');
    const body = `
      <div class="alert alert-info">Schedule a new lecture slot for the selected class.</div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Subject <span class="req">*</span></label><select class="form-select" name="subject_id">${subjOpts}</select></div>
        <div class="form-group"><label class="form-label">Teacher</label><select class="form-select" name="teacher_id">${teacherOpts}</select></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Day <span class="req">*</span></label><select class="form-select" name="day_of_week">${dayOpts}</select></div>
        <div class="form-group"><label class="form-label">Room</label><input class="form-control" name="room" placeholder="Room 201"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Start Time <span class="req">*</span></label><input class="form-control" type="time" name="start_time" value="09:00" required></div>
        <div class="form-group"><label class="form-label">End Time <span class="req">*</span></label><input class="form-control" type="time" name="end_time" value="10:00" required></div>
      </div>
    `;
    const { close } = ERP.modal({
      title: '➕ Add Timetable Slot', body, size: 'lg',
      footer: `<button class="btn btn-ghost" id="slotCancelBtn">Cancel</button><button class="btn btn-primary" id="slotSaveBtn">Add Slot</button>`
    });
    document.getElementById('slotCancelBtn').addEventListener('click', close);
    document.getElementById('slotSaveBtn').addEventListener('click', () => submitSlot(close));
  }
  async function submitSlot(closeFn) {
    const modalBody = document.querySelector('.modal-overlay .modal-body');
    const data = {};
    modalBody.querySelectorAll('[name]').forEach(i => { data[i.name] = i.value; });
    data.class_id = CLASS_ID;
    const btn = document.getElementById('slotSaveBtn');
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const res = await ERP.api('/api/admin/timetable', { method: 'POST', body: data });
      ERP.toast('Success', res.message || 'Slot scheduled.', 'success');
      setTimeout(() => location.reload(), 700);
    } catch (err) { ERP.toast('Error', err.message, 'error'); btn.disabled = false; btn.textContent = 'Add Slot'; }
  }
  function deleteSlot(id) {
    ERP.confirmDialog('Delete Slot', 'Remove this lecture slot from the timetable?', async () => {
      try {
        const res = await ERP.api('/api/admin/timetable/' + id, { method: 'DELETE' });
        ERP.toast('Deleted', res.message || 'Slot removed.', 'success');
        setTimeout(() => location.reload(), 700);
      } catch (err) { ERP.toast('Error', err.message, 'error'); }
    }, { okText: 'Delete', danger: true });
  }
</script>
<%- include('../partials/layout-bottom') %>
