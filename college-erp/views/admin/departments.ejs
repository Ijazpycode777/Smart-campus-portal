<%- include('../partials/layout-top') %>
<%
  const totalDepts = departments.length;
  const totalStudents = departments.reduce((a, d) => a + (d.student_count || 0), 0);
  const totalTeachers = departments.reduce((a, d) => a + (d.teacher_count || 0), 0);
  const totalCourses = departments.reduce((a, d) => a + (d.course_count || 0), 0);
  const cardColors = ['#6366f1','#ec4899','#f59e0b','#10b981','#3b82f6','#8b5cf6','#06b6d4','#f97316','#14b8a6'];
%>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Organizational Structure</div>
    <h1>Departments</h1>
    <p>Each department of <%= collegeName %> is a self-managed unit with its own HOD, faculty, courses and student body.</p>
    <div class="hero-stat">
      <div class="num"><%= totalDepts %></div>
      <div class="lbl">Departments</div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">🏛️</div>
    <div style="flex:1">
      <div class="stat-label">Total Departments</div>
      <div class="stat-value"><%= totalDepts %></div>
      <div class="stat-delta up">▲ Across institution</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">👥</div>
    <div style="flex:1">
      <div class="stat-label">Total Students</div>
      <div class="stat-value"><%= totalStudents %></div>
      <div class="stat-delta up">▲ Across departments</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">👨‍🏫</div>
    <div style="flex:1">
      <div class="stat-label">Faculty Members</div>
      <div class="stat-value"><%= totalTeachers %></div>
      <div class="stat-delta up">▲ Teaching staff</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon pink">🎓</div>
    <div style="flex:1">
      <div class="stat-label">Total Courses</div>
      <div class="stat-value"><%= totalCourses %></div>
      <div class="stat-delta up">▲ Programs offered</div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <div class="card-title">All Departments</div>
    <button class="btn btn-primary btn-sm" onclick="openAddDepartment()">➕ Add Department</button>
  </div>
  <div class="card-body" style="padding:0">
    <% if (!departments.length) { %>
      <div class="empty"><div class="empty-icon">🏛️</div><div class="empty-title">No departments yet</div><div class="empty-sub">Create your first department to organize courses and faculty.</div></div>
    <% } else { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px;padding:20px">
        <% departments.forEach((d, i) => {
          const color = cardColors[i % cardColors.length];
        %>
          <div class="card" style="transition:all .2s">
            <div class="card-body" style="padding:18px">
              <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:14px">
                <div style="width:56px;height:56px;border-radius:14px;background:<%= color %>22;color:<%= color %>;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;flex-shrink:0;font-family:var(--font-mono)"><%= d.code %></div>
                <div style="flex:1;min-width:0">
                  <div style="font-weight:700;font-size:15px;color:var(--gray-900)"><%= d.name %></div>
                  <div class="text-xs text-muted" style="margin-top:2px">HOD: <strong style="color:var(--gray-700)"><%= d.hod_name || 'Not assigned' %></strong></div>
                </div>
              </div>
              <div class="text-xs text-muted" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:14px;min-height:34px"><%= d.description || 'No description provided for this department.' %></div>
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;padding-top:14px;border-top:1px solid var(--border)">
                <div style="text-align:center;padding:8px 4px;background:var(--surface-2);border-radius:8px">
                  <div style="font-size:18px;font-weight:800;color:var(--brand-600)"><%= d.student_count || 0 %></div>
                  <div class="text-xs text-muted">Students</div>
                </div>
                <div style="text-align:center;padding:8px 4px;background:var(--surface-2);border-radius:8px">
                  <div style="font-size:18px;font-weight:800;color:var(--success)"><%= d.teacher_count || 0 %></div>
                  <div class="text-xs text-muted">Teachers</div>
                </div>
                <div style="text-align:center;padding:8px 4px;background:var(--surface-2);border-radius:8px">
                  <div style="font-size:18px;font-weight:800;color:var(--accent-amber)"><%= d.course_count || 0 %></div>
                  <div class="text-xs text-muted">Courses</div>
                </div>
              </div>
              <div style="display:flex;justify-content:flex-end;gap:4px;margin-top:12px">
                <button class="btn btn-ghost btn-sm" onclick='editDepartment(<%- JSON.stringify(d) %>)'>✏️ Edit</button>
                <button class="btn btn-ghost btn-sm" style="color:var(--danger)" onclick="deleteDepartment(<%= d.id %>, '<%= helpers.escapeHtml(d.name) %>')">🗑️</button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
  function openAddDepartment() {
    const body = `
      <div class="form-row">
        <div class="form-group"><label class="form-label">Department Code <span class="req">*</span></label><input class="form-control" name="code" placeholder="CSE" required maxlength="10"></div>
        <div class="form-group"><label class="form-label">Department Name <span class="req">*</span></label><input class="form-control" name="name" placeholder="Computer Science & Engineering" required></div>
      </div>
      <div class="form-group"><label class="form-label">Head of Department (HOD)</label><input class="form-control" name="hod_name" placeholder="Dr. John Doe"></div>
      <div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" name="description" placeholder="Brief overview of the department's vision and offerings…"></textarea></div>
    `;
    const { close } = ERP.modal({
      title: '➕ Add New Department', body, size: 'lg',
      footer: `<button class="btn btn-ghost" id="deptCancelBtn">Cancel</button><button class="btn btn-primary" id="deptSaveBtn">Create Department</button>`
    });
    document.getElementById('deptCancelBtn').addEventListener('click', close);
    document.getElementById('deptSaveBtn').addEventListener('click', () => submitDepartment(null, close));
  }
  function editDepartment(d) {
    const body = `
      <div class="form-row">
        <div class="form-group"><label class="form-label">Department Code</label><input class="form-control" name="code" value="${ERP.escapeHtml(d.code || '')}"></div>
        <div class="form-group"><label class="form-label">Department Name</label><input class="form-control" name="name" value="${ERP.escapeHtml(d.name || '')}"></div>
      </div>
      <div class="form-group"><label class="form-label">Head of Department (HOD)</label><input class="form-control" name="hod_name" value="${ERP.escapeHtml(d.hod_name || '')}"></div>
      <div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" name="description">${ERP.escapeHtml(d.description || '')}</textarea></div>
    `;
    const { close } = ERP.modal({
      title: `✏️ Edit ${d.name}`, body, size: 'lg',
      footer: `<button class="btn btn-ghost" id="deptCancelBtn">Cancel</button><button class="btn btn-primary" id="deptSaveBtn">Save Changes</button>`
    });
    document.getElementById('deptCancelBtn').addEventListener('click', close);
    document.getElementById('deptSaveBtn').addEventListener('click', () => submitDepartment(d.id, close));
  }
  async function submitDepartment(id, closeFn) {
    const modalBody = document.querySelector('.modal-overlay .modal-body');
    const data = {};
    modalBody.querySelectorAll('[name]').forEach(i => { data[i.name] = i.value; });
    const url = id ? '/api/admin/departments/' + id : '/api/admin/departments';
    const method = id ? 'PUT' : 'POST';
    const btn = document.getElementById('deptSaveBtn');
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const res = await ERP.api(url, { method, body: data });
      ERP.toast('Success', res.message || (id ? 'Department updated.' : 'Department created.'), 'success');
      setTimeout(() => location.reload(), 700);
    } catch (err) {
      ERP.toast('Error', err.message || (err.status === 404 ? 'API endpoint not available yet.' : 'Request failed.'), 'error');
      btn.disabled = false; btn.textContent = id ? 'Save Changes' : 'Create Department';
    }
  }
  function deleteDepartment(id, name) {
    ERP.confirmDialog('Delete Department', `Are you sure you want to delete <strong>${name}</strong>? Linked courses and faculty may need reassignment.`, async () => {
      try {
        const res = await ERP.api('/api/admin/departments/' + id, { method: 'DELETE' });
        ERP.toast('Deleted', res.message || 'Department removed.', 'success');
        setTimeout(() => location.reload(), 700);
      } catch (err) { ERP.toast('Error', err.message, 'error'); }
    }, { okText: 'Delete', danger: true });
  }
</script>
<%- include('../partials/layout-bottom') %>
