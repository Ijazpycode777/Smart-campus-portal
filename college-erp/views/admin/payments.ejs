<%- include('../partials/layout-top') %>
<%
  const txCount = payments.length;
  // Group payments by month (last 6 months)
  const now = new Date();
  const months = [];
  for (let i = 5; i >= 0; i--) {
    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
    months.push({ key: d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0'), label: d.toLocaleString('en-US', { month: 'short' }), total: 0 });
  }
  payments.forEach(p => {
    if (!p.payment_date) return;
    const d = new Date(p.payment_date);
    if (isNaN(d.getTime())) return;
    const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
    const m = months.find(x => x.key === key);
    if (m) m.total += parseFloat(p.amount) || 0;
  });
  const trendData = months.map(m => ({ label: m.label, value: Math.round(m.total / 1000) }));
  const methodColors = { cash: 'badge-warning', upi: 'badge-success', card: 'badge-info', bank_transfer: 'badge-purple', cheque: 'badge-neutral' };
  const bestMonth = months.reduce((a, b) => b.total > a.total ? b : a, months[0]);
%>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Finance Ledger</div>
    <h1>Payments Received</h1>
    <p>Track every fee payment received across <%= collegeName %> — today, this month, and the 6-month collection trend.</p>
    <div class="hero-stat">
      <div class="num"><%= txCount %></div>
      <div class="lbl">Transactions</div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon green">💰</div>
    <div style="flex:1">
      <div class="stat-label">Total Collected</div>
      <div class="stat-value"><%= helpers.formatCurrency(totalCollected) %></div>
      <div class="stat-delta up">▲ All-time receipts</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon brand">📅</div>
    <div style="flex:1">
      <div class="stat-label">Collected Today</div>
      <div class="stat-value"><%= helpers.formatCurrency(todayCollected) %></div>
      <div class="stat-delta up">▲ Same-day receipts</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">📆</div>
    <div style="flex:1">
      <div class="stat-label">This Month</div>
      <div class="stat-value"><%= helpers.formatCurrency(monthCollected) %></div>
      <div class="stat-delta up">▲ Month-to-date</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon pink">🔢</div>
    <div style="flex:1">
      <div class="stat-label">Transactions</div>
      <div class="stat-value"><%= txCount %></div>
      <div class="stat-delta up">▲ Total payment count</div>
    </div>
  </div>
</div>

<div class="charts-grid">
  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">6-Month Collection Trend</div>
        <div class="text-xs text-muted">Total fees collected per month (in <%= currencySymbol %> thousands)</div>
      </div>
      <span class="badge badge-success badge-dot">Live</span>
    </div>
    <div class="card-body">
      <canvas data-chart="line" data-data='<%= JSON.stringify(trendData) %>' style="width:100%;height:240px"></canvas>
      <div style="display:flex;justify-content:space-between;margin-top:12px;padding-top:12px;border-top:1px solid var(--border);flex-wrap:wrap;gap:8px">
        <div><div class="text-xs text-muted">Best Month</div><div style="font-weight:800;color:var(--accent-amber);font-size:16px"><%= bestMonth.label %></div></div>
        <div><div class="text-xs text-muted">Best Month Amount</div><div style="font-weight:800;color:var(--success);font-size:16px"><%= helpers.formatCurrency(bestMonth.total) %></div></div>
        <div><div class="text-xs text-muted">Avg / Month</div><div style="font-weight:800;color:var(--brand-600);font-size:16px"><%= helpers.formatCurrency(months.reduce((a,b) => a + b.total, 0) / months.length) %></div></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">Payment Methods</div>
    </div>
    <div class="card-body">
      <% const methodMap = {};
      payments.forEach(p => { const m = (p.payment_method || 'unknown').toLowerCase(); methodMap[m] = (methodMap[m] || 0) + 1; });
      const methodTotal = Object.values(methodMap).reduce((a, b) => a + b, 0) || 1;
      const methodIcon = { cash: '💵', upi: '📱', card: '💳', bank_transfer: '🏦', cheque: '📝' };
      %>
      <div style="display:grid;gap:10px">
        <% Object.keys(methodMap).forEach(m => { const pct = Math.round((methodMap[m] / methodTotal) * 100); %>
          <div>
            <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px"><span><%= methodIcon[m] || '•' %> <%= m.replace('_', ' ').toUpperCase() %></span><strong><%= methodMap[m] %> · <%= pct %>%</strong></div>
            <div style="height:6px;background:var(--gray-100);border-radius:3px;overflow:hidden"><div style="height:100%;width:<%= pct %>%;background:var(--brand-500)"></div></div>
          </div>
        <% }) %>
        <% if (!Object.keys(methodMap).length) { %>
          <div class="empty"><div class="empty-sub">No payment data yet.</div></div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Payment Transactions</div>
      <div class="text-xs text-muted"><%= payments.length %> total transactions recorded</div>
    </div>
    <button class="btn btn-ghost btn-sm" onclick="exportPayments()">⬇ Export CSV</button>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Transaction ID</th><th>Invoice</th><th>Student</th><th>Amount</th><th>Method</th><th>Date</th></tr></thead>
      <tbody>
        <% if (!payments.length) { %>
          <tr><td colspan="6"><div class="empty"><div class="empty-icon">💸</div><div class="empty-title">No payments recorded</div><div class="empty-sub">Payments will appear here once invoices are paid.</div></div></td></tr>
        <% } %>
        <% payments.slice().reverse().forEach(p => { %>
          <tr>
            <td><strong style="font-family:var(--font-mono);font-size:12px"><%= p.transaction_id || '—' %></strong></td>
            <td><span class="badge badge-neutral"><%= p.invoice_number %></span></td>
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <div class="avatar avatar-sm" style="background:<%= p.avatar_color %>"><%= helpers.initials(p.full_name) %></div>
                <div>
                  <div style="font-weight:600;color:var(--gray-900)"><%= p.full_name %></div>
                  <div class="text-xs text-muted"><%= p.roll_number %></div>
                </div>
              </div>
            </td>
            <td><strong style="color:var(--success)"><%= helpers.formatCurrency(p.amount) %></strong></td>
            <td><span class="badge <%= methodColors[(p.payment_method || '').toLowerCase()] || 'badge-neutral' %>"><%= (p.payment_method || '—').toUpperCase().replace('_', ' ') %></span></td>
            <td><%= helpers.formatDateTime(p.payment_date) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  function exportPayments() {
    const rows = <%- JSON.stringify(payments.map(p => ({txn:p.transaction_id||'', inv:p.invoice_number, student:p.full_name, roll:p.roll_number, amount:p.amount, method:p.payment_method, date:p.payment_date}))) %>;
    const csv = ['TxnID,Invoice,Student,Roll,Amount,Method,Date'].concat(rows.map(r => [r.txn,r.inv,r.student,r.roll,r.amount,r.method,r.date].map(x => `"${x}"`).join(','))).join('\n');
    const blob = new Blob([csv], {type:'text/csv'}); const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = 'payments.csv'; a.click();
    ERP.toast('Exported', 'payments.csv downloaded.', 'success');
  }
</script>
<%- include('../partials/layout-bottom') %>
