<%- include('../partials/layout-top') %>
<%
  const totalLogs = logs.length;
  const actions = {};
  logs.forEach(l => { actions[l.action] = (actions[l.action] || 0) + 1; });
  const topActions = Object.entries(actions).sort((a, b) => b[1] - a[1]).slice(0, 6);
  const uniqueUsers = new Set(logs.map(l => l.user_id)).size;
  const last24h = logs.filter(l => new Date(l.created_at) >= new Date(Date.now() - 86400000)).length;
  const actionColors = { create: 'badge-success', update: 'badge-info', delete: 'badge-danger', login: 'badge-purple', logout: 'badge-neutral', view: 'badge-neutral' };
  const roleColor = (r) => ({ admin: '#6366f1', teacher: '#10b981', student: '#ec4899' }[r] || '#6b7280');
%>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Audit Trail</div>
    <h1>Activity Log</h1>
    <p>Audit every action taken in <%= collegeName %>'s ERP — logins, edits, deletions and data access, by user and IP.</p>
    <div class="hero-stat">
      <div class="num"><%= totalLogs %></div>
      <div class="lbl">Logged Events</div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📊</div>
    <div style="flex:1">
      <div class="stat-label">Total Events</div>
      <div class="stat-value"><%= totalLogs %></div>
      <div class="stat-delta up">▲ Logged all-time</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">👥</div>
    <div style="flex:1">
      <div class="stat-label">Active Users</div>
      <div class="stat-value"><%= uniqueUsers %></div>
      <div class="stat-delta up">▲ Tracked in logs</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">⏱️</div>
    <div style="flex:1">
      <div class="stat-label">Last 24 Hours</div>
      <div class="stat-value"><%= last24h %></div>
      <div class="stat-delta up">▲ Recent activity</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon pink">⚡</div>
    <div style="flex:1">
      <div class="stat-label">Distinct Actions</div>
      <div class="stat-value"><%= Object.keys(actions).length %></div>
      <div class="stat-delta up">▲ Action types</div>
    </div>
  </div>
</div>

<div class="charts-grid">
  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">Activity Log</div>
        <div class="text-xs text-muted"><%= logs.length %> entries · filter by action type</div>
      </div>
    </div>
    <div class="card-body" style="padding:0">
      <div style="padding:12px 18px;border-bottom:1px solid var(--border);display:flex;gap:6px;flex-wrap:wrap;align-items:center">
        <span class="text-xs text-muted" style="margin-right:4px">Filter:</span>
        <button class="badge badge-success" data-filter="all" style="padding:6px 12px;font-size:11px;cursor:pointer;border:0">All</button>
        <% Object.keys(actions).forEach(a => { %>
          <button class="badge badge-neutral" data-filter="<%= a %>" style="padding:6px 12px;font-size:11px;cursor:pointer;border:0"><%= a %> (<%= actions[a] %>)</button>
        <% }) %>
      </div>
      <div style="max-height:520px;overflow-y:auto" id="logList">
        <% if (!logs.length) { %>
          <div class="empty"><div class="empty-icon">📊</div><div class="empty-title">No activity recorded</div><div class="empty-sub">Logs will appear here as users interact with the system.</div></div>
        <% } %>
        <% logs.forEach(l => { %>
          <div data-action="<%= l.action %>" style="display:flex;gap:12px;padding:12px 20px;border-bottom:1px solid var(--border)">
            <div class="avatar avatar-sm" style="background:<%= roleColor(l.role) %>"><%= helpers.initials(l.full_name) %></div>
            <div style="flex:1;min-width:0">
              <div style="font-size:13px">
                <strong><%= l.full_name || 'System' %></strong>
                <span class="badge <%= roleColor(l.role) === '#6366f1' ? 'badge-purple' : roleColor(l.role) === '#10b981' ? 'badge-success' : 'badge-info' %>" style="margin-left:4px"><%= l.role %></span>
                <span style="color:var(--gray-500)"> <%= l.action %> </span>
                <% if (l.entity_type) { %><span class="badge <%= actionColors[l.action] || 'badge-neutral' %>"><%= l.entity_type %></span><% } %>
              </div>
              <div class="text-xs text-muted truncate" style="margin-top:2px"><%= l.details || '—' %></div>
            </div>
            <div style="text-align:right;flex-shrink:0">
              <div class="text-xs text-muted"><%= helpers.timeAgo(l.created_at) %></div>
              <div class="text-xs" style="font-family:var(--font-mono);color:var(--gray-400)"><%= l.ip_address || '—' %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">Top Actions</div>
    </div>
    <div class="card-body">
      <div style="display:grid;gap:10px">
        <% topActions.forEach(([action, count]) => {
          const pct = Math.round((count / totalLogs) * 100);
        %>
          <div>
            <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
              <span class="badge <%= actionColors[action] || 'badge-neutral' %>"><%= action %></span>
              <strong><%= count %> · <%= pct %>%</strong>
            </div>
            <div style="height:6px;background:var(--gray-100);border-radius:3px;overflow:hidden"><div style="height:100%;width:<%= pct %>%;background:var(--brand-500)"></div></div>
          </div>
        <% }) %>
        <% if (!topActions.length) { %>
          <div class="empty"><div class="empty-sub">No action data.</div></div>
        <% } %>
      </div>
      <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border)">
        <div class="text-xs text-muted" style="margin-bottom:8px">Active IP Addresses</div>
        <% const ipMap = {}; logs.forEach(l => { if (l.ip_address) ipMap[l.ip_address] = (ipMap[l.ip_address] || 0) + 1; });
        const topIps = Object.entries(ipMap).sort((a,b) => b[1]-a[1]).slice(0,5); %>
        <% topIps.forEach(([ip, count]) => { %>
          <div style="display:flex;justify-content:space-between;font-size:12px;padding:4px 0"><span style="font-family:var(--font-mono);color:var(--gray-600)"><%= ip %></span><strong><%= count %></strong></div>
        <% }) %>
        <% if (!topIps.length) { %><div class="text-xs text-muted">No IP data.</div><% } %>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach(b => { b.classList.remove('badge-success'); b.classList.add('badge-neutral'); });
      btn.classList.remove('badge-neutral'); btn.classList.add('badge-success');
      document.querySelectorAll('#logList [data-action]').forEach(row => {
        row.style.display = (filter === 'all' || row.dataset.action === filter) ? 'flex' : 'none';
      });
    });
  });
</script>
<%- include('../partials/layout-bottom') %>
