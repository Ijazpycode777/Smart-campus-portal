<%- include('../partials/layout-top') %>
<%
  const totalExams = exams.length;
  const midterms = exams.filter(e => e.exam_type === 'midterm' || e.exam_type === 'mid-term').length;
  const finals = exams.filter(e => e.exam_type === 'final').length;
  const totalResults = exams.reduce((a, e) => a + (e.results_count || 0), 0);
  const typeBadge = (t) => {
    const map = { midterm: 'badge-info', 'mid-term': 'badge-info', final: 'badge-purple', quiz: 'badge-warning', assignment: 'badge-neutral', practical: 'badge-success' };
    return map[t] || 'badge-neutral';
  };
  const typeLabel = (t) => t ? t.charAt(0).toUpperCase() + t.slice(1) : '—';
%>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Evaluation Hub</div>
    <h1>Examinations</h1>
    <p>Schedule exams, define marking schemes and track result entry across every class for the academic year <%= academicYear %>.</p>
    <div class="hero-stat">
      <div class="num"><%= totalExams %></div>
      <div class="lbl">Scheduled Exams</div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📝</div>
    <div style="flex:1">
      <div class="stat-label">Total Exams</div>
      <div class="stat-value"><%= totalExams %></div>
      <div class="stat-delta up">▲ Across all classes</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon info" style="background:var(--gradient-ocean);box-shadow:0 6px 16px rgba(59,130,246,.35)">📐</div>
    <div style="flex:1">
      <div class="stat-label">Midterm Exams</div>
      <div class="stat-value"><%= midterms %></div>
      <div class="stat-delta up">▲ Continuous evaluation</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon violet" style="background:linear-gradient(135deg,#8b5cf6,#a78bfa);box-shadow:0 6px 16px rgba(139,92,246,.35)">🎓</div>
    <div style="flex:1">
      <div class="stat-label">Final Exams</div>
      <div class="stat-value"><%= finals %></div>
      <div class="stat-delta up">▲ End-of-term exams</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon green">📊</div>
    <div style="flex:1">
      <div class="stat-label">Results Recorded</div>
      <div class="stat-value"><%= totalResults %></div>
      <div class="stat-delta up">▲ Marks across exams</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Examination Schedule</div>
      <div class="text-xs text-muted"><%= exams.length %> exams · <%= totalResults %> results entered</div>
    </div>
    <button class="btn btn-primary btn-sm" onclick="openAddExam()">➕ Schedule Exam</button>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Exam Name</th><th>Type</th><th>Class</th><th>Subject</th><th>Marks</th><th>Exam Date</th><th>Results</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (!exams.length) { %>
          <tr><td colspan="8"><div class="empty"><div class="empty-icon">📝</div><div class="empty-title">No exams scheduled</div><div class="empty-sub">Click "Schedule Exam" to create one.</div></div></td></tr>
        <% } %>
        <% exams.forEach(e => { %>
          <tr>
            <td>
              <div style="font-weight:600;color:var(--gray-900)"><%= e.name %></div>
              <div class="text-xs text-muted">AY <%= e.academic_year || academicYear %> · by <%= e.created_by_name || 'System' %></div>
            </td>
            <td><span class="badge <%= typeBadge(e.exam_type) %>"><%= typeLabel(e.exam_type) %></span></td>
            <td><strong><%= e.class_name || '—' %></strong></td>
            <td>
              <div><strong style="font-family:var(--font-mono)"><%= e.subject_code || '—' %></strong></div>
              <div class="text-xs text-muted"><%= e.subject_name || '—' %></div>
            </td>
            <td>
              <div><strong><%= e.total_marks %></strong> total</div>
              <div class="text-xs text-muted"><%= e.passing_marks %> pass</div>
            </td>
            <td><% if (e.exam_date) { %><%= helpers.formatDate(e.exam_date) %><% } else { %><span class="text-muted">—</span><% } %></td>
            <td>
              <% if (e.results_count > 0) { %>
                <span class="badge badge-success badge-dot"><%= e.results_count %> results</span>
              <% } else { %>
                <span class="badge badge-neutral badge-dot">No entry</span>
              <% } %>
            </td>
            <td>
              <div style="display:flex;gap:4px">
                <a class="btn btn-primary btn-sm" href="/admin/results?exam_id=<%= e.id %>">📊 View Results</a>
                <button class="btn btn-ghost btn-sm" style="color:var(--danger)" onclick="deleteExam(<%= e.id %>, '<%= helpers.escapeHtml(e.name) %>')">🗑️</button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  const CLASSES = <%- JSON.stringify(classes) %>;
  function openAddExam() {
    const classOpts = `<option value="">— Select class —</option>` + CLASSES.map(c => `<option value="${c.id}">${c.name} · ${c.course_code}</option>`).join('');
    const body = `
      <div class="form-group"><label class="form-label">Exam Name <span class="req">*</span></label><input class="form-control" name="name" placeholder="Mid-Term Examination 2026" required></div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Exam Type</label><select class="form-select" name="exam_type"><option value="midterm">Midterm</option><option value="final">Final</option><option value="quiz">Quiz</option><option value="assignment">Assignment</option><option value="practical">Practical</option></select></div>
        <div class="form-group"><label class="form-label">Class</label><select class="form-select" name="class_id">${classOpts}</select></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Subject Code</label><input class="form-control" name="subject_code" placeholder="CS101"></div>
        <div class="form-group"><label class="form-label">Subject Name</label><input class="form-control" name="subject_name" placeholder="Data Structures"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Total Marks</label><input class="form-control" type="number" name="total_marks" min="1" value="100"></div>
        <div class="form-group"><label class="form-label">Passing Marks</label><input class="form-control" type="number" name="passing_marks" min="0" value="40"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Exam Date</label><input class="form-control" type="date" name="exam_date" value="${new Date().toISOString().slice(0,10)}"></div>
        <div class="form-group"><label class="form-label">Academic Year</label><input class="form-control" name="academic_year" value="${new Date().getFullYear()}-${new Date().getFullYear()+1}"></div>
      </div>
    `;
    const { close } = ERP.modal({
      title: '➕ Schedule New Exam', body, size: 'lg',
      footer: `<button class="btn btn-ghost" id="examCancelBtn">Cancel</button><button class="btn btn-primary" id="examSaveBtn">Schedule Exam</button>`
    });
    document.getElementById('examCancelBtn').addEventListener('click', close);
    document.getElementById('examSaveBtn').addEventListener('click', () => submitExam(close));
  }
  async function submitExam(closeFn) {
    const modalBody = document.querySelector('.modal-overlay .modal-body');
    const data = {};
    modalBody.querySelectorAll('[name]').forEach(i => { data[i.name] = i.value; });
    const btn = document.getElementById('examSaveBtn');
    btn.disabled = true; btn.textContent = 'Scheduling…';
    try {
      const res = await ERP.api('/api/admin/examinations', { method: 'POST', body: data });
      ERP.toast('Success', res.message || 'Exam scheduled.', 'success');
      setTimeout(() => location.reload(), 700);
    } catch (err) { ERP.toast('Error', err.message, 'error'); btn.disabled = false; btn.textContent = 'Schedule Exam'; }
  }
  function deleteExam(id, name) {
    ERP.confirmDialog('Delete Exam', `Delete <strong>${name}</strong>? All associated results will also be removed.`, async () => {
      try {
        const res = await ERP.api('/api/admin/examinations/' + id, { method: 'DELETE' });
        ERP.toast('Deleted', res.message || 'Exam removed.', 'success');
        setTimeout(() => location.reload(), 700);
      } catch (err) { ERP.toast('Error', err.message, 'error'); }
    }, { okText: 'Delete', danger: true });
  }
</script>
<%- include('../partials/layout-bottom') %>
