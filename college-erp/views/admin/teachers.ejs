<%- include('../partials/layout-top') %>
<%
  const totalTeachers = teachers.length;
  const totalClasses = teachers.reduce((a, t) => a + (t.class_count || 0), 0);
  const avgExp = totalTeachers ? (teachers.reduce((a, t) => a + (t.experience_years || 0), 0) / totalTeachers) : 0;
  const totalSalary = teachers.reduce((a, t) => a + (parseFloat(t.salary) || 0), 0);
  const designations = ['Professor','Associate Professor','Assistant Professor','Lecturer','Visiting Faculty','Lab Instructor'];
%>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Faculty Management</div>
    <h1>Teachers & Faculty</h1>
    <p>Recruit, organize and oversee every faculty member of <%= collegeName %> — qualifications, classes, salaries and tenure.</p>
    <div class="hero-stat">
      <div class="num"><%= totalTeachers %></div>
      <div class="lbl">Faculty Members</div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">👨‍🏫</div>
    <div style="flex:1">
      <div class="stat-label">Total Teachers</div>
      <div class="stat-value"><%= totalTeachers %></div>
      <div class="stat-delta up">▲ Active faculty on payroll</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">📚</div>
    <div style="flex:1">
      <div class="stat-label">Total Classes</div>
      <div class="stat-value"><%= totalClasses %></div>
      <div class="stat-delta up">▲ Assigned across faculty</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">⏱️</div>
    <div style="flex:1">
      <div class="stat-label">Avg Experience</div>
      <div class="stat-value"><%= avgExp.toFixed(1) %> yrs</div>
      <div class="stat-delta up">▲ Industry & academic</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon pink">💰</div>
    <div style="flex:1">
      <div class="stat-label">Monthly Salary Payout</div>
      <div class="stat-value"><%= helpers.formatCurrency(totalSalary) %></div>
      <div class="stat-delta down">▼ Recurring monthly cost</div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <div class="card-title">Search & Filter</div>
    <button class="btn btn-primary btn-sm" onclick="openAddTeacher()">➕ Add Teacher</button>
  </div>
  <div class="card-body" style="padding:14px 18px">
    <form method="GET" style="display:grid;grid-template-columns:2fr 1fr auto;gap:10px;align-items:end">
      <div class="form-group" style="margin:0">
        <label class="form-label">Search</label>
        <input class="form-control" type="text" name="q" value="<%= q %>" placeholder="Name, employee ID, email or phone">
      </div>
      <div class="form-group" style="margin:0">
        <label class="form-label">Department</label>
        <select class="form-select" name="department_id">
          <option value="">All departments</option>
          <% departments.forEach(d => { %><option value="<%= d.id %>"><%= d.code %> — <%= d.name %></option><% }) %>
        </select>
      </div>
      <button class="btn btn-primary" type="submit">🔍 Filter</button>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Faculty Directory</div>
      <div class="text-xs text-muted"><%= teachers.length %> teachers · <%= departments.length %> departments</div>
    </div>
    <button class="btn btn-ghost btn-sm" onclick="exportTeachers()">⬇ Export CSV</button>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Teacher</th><th>Employee ID</th><th>Department</th><th>Designation</th><th>Experience</th><th>Salary</th><th>Classes</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (!teachers.length) { %>
          <tr><td colspan="9"><div class="empty"><div class="empty-icon">👩‍🏫</div><div class="empty-title">No teachers found</div><div class="empty-sub">Try adjusting your filters or add a new teacher.</div></div></td></tr>
        <% } %>
        <% teachers.forEach(t => { %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <div class="avatar avatar-sm" style="background:<%= t.avatar_color %>"><%= helpers.initials(t.full_name) %></div>
                <div>
                  <div style="font-weight:600;color:var(--gray-900)"><%= t.full_name %></div>
                  <div class="text-xs text-muted"><%= t.email %><% if (t.specialization) { %> · <%= t.specialization %><% } %></div>
                </div>
              </div>
            </td>
            <td><strong style="font-family:var(--font-mono);font-size:12px"><%= t.employee_id %></strong></td>
            <td><span class="badge badge-neutral"><%= t.dept_code || '—' %></span><div class="text-xs text-muted"><%= t.dept_name || '—' %></div></td>
            <td><span class="badge badge-info"><%= t.designation || '—' %></span></td>
            <td><% if (t.experience_years) { %><strong><%= t.experience_years %></strong> yrs<% } else { %><span class="text-muted">—</span><% } %></td>
            <td><strong><%= helpers.formatCurrency(t.salary) %></strong><div class="text-xs text-muted">since <%= helpers.formatDate(t.join_date) %></div></td>
            <td><strong><%= t.class_count || 0 %></strong> <span class="text-xs text-muted">classes</span></td>
            <td><% if (t.is_active) { %><span class="badge badge-success badge-dot">Active</span><% } else { %><span class="badge badge-neutral badge-dot">Inactive</span><% } %></td>
            <td>
              <div style="display:flex;gap:4px">
                <button class="btn btn-ghost btn-sm" onclick='openEditTeacher(<%- JSON.stringify(t) %>, <%- JSON.stringify(departments) %>)'>✏️</button>
                <button class="btn btn-ghost btn-sm" style="color:var(--danger)" onclick="deleteTeacher(<%= t.id %>, '<%= helpers.escapeHtml(t.full_name) %>')">🗑️</button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div id="teacherModalMount"></div>

<script>
  const DEPARTMENTS = <%- JSON.stringify(departments) %>;
  const DESIGNATIONS = <%- JSON.stringify(designations) %>;
  function openAddTeacher() {
    const deptOpts = DEPARTMENTS.map(d => `<option value="${d.id}">${d.code} — ${d.name}</option>`).join('');
    const desOpts = DESIGNATIONS.map(d => `<option value="${d}">${d}</option>`).join('');
    const body = `
      <div class="form-row">
        <div class="form-group"><label class="form-label">Full Name <span class="req">*</span></label><input class="form-control" name="full_name" required></div>
        <div class="form-group"><label class="form-label">Employee ID <span class="req">*</span></label><input class="form-control" name="employee_id" required placeholder="EMP-001"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Username <span class="req">*</span></label><input class="form-control" name="username" required></div>
        <div class="form-group"><label class="form-label">Email <span class="req">*</span></label><input class="form-control" type="email" name="email" required></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Phone</label><input class="form-control" name="phone" placeholder="+91"></div>
        <div class="form-group"><label class="form-label">Default Password</label><input class="form-control" name="password" value="teacher123"><div class="form-hint">User can change later from profile</div></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Department</label><select class="form-select" name="department_id">${deptOpts}</select></div>
        <div class="form-group"><label class="form-label">Designation</label><select class="form-select" name="designation">${desOpts}</select></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Qualification</label><input class="form-control" name="qualification" placeholder="Ph.D, M.Tech"></div>
        <div class="form-group"><label class="form-label">Specialization</label><input class="form-control" name="specialization" placeholder="Machine Learning"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Salary</label><input class="form-control" type="number" name="salary" min="0" placeholder="50000"></div>
        <div class="form-group"><label class="form-label">Experience (years)</label><input class="form-control" type="number" name="experience_years" min="0" step="0.5" placeholder="5"></div>
      </div>
      <div class="form-group"><label class="form-label">Join Date</label><input class="form-control" type="date" name="join_date" value="${new Date().toISOString().slice(0,10)}"></div>
    `;
    const { close } = ERP.modal({
      title: '➕ Add New Teacher',
      body,
      size: 'lg',
      footer: `<button class="btn btn-ghost" id="teacherCancelBtn">Cancel</button><button class="btn btn-primary" id="teacherSaveBtn">Create Teacher</button>`
    });
    document.getElementById('teacherCancelBtn').addEventListener('click', close);
    document.getElementById('teacherSaveBtn').addEventListener('click', () => submitTeacher(null, close));
  }
  function openEditTeacher(t, depts) {
    const deptOpts = depts.map(d => `<option value="${d.id}" ${d.id == t.department_id ? 'selected' : ''}>${d.code} — ${d.name}</option>`).join('');
    const desOpts = DESIGNATIONS.map(d => `<option value="${d}" ${d === t.designation ? 'selected' : ''}>${d}</option>`).join('');
    const body = `
      <div class="form-row">
        <div class="form-group"><label class="form-label">Full Name</label><input class="form-control" name="full_name" value="${ERP.escapeHtml(t.full_name || '')}"></div>
        <div class="form-group"><label class="form-label">Employee ID</label><input class="form-control" name="employee_id" value="${ERP.escapeHtml(t.employee_id || '')}"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="${ERP.escapeHtml(t.email || '')}"></div>
        <div class="form-group"><label class="form-label">Phone</label><input class="form-control" name="phone" value="${ERP.escapeHtml(t.phone || '')}"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Department</label><select class="form-select" name="department_id">${deptOpts}</select></div>
        <div class="form-group"><label class="form-label">Designation</label><select class="form-select" name="designation">${desOpts}</select></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Qualification</label><input class="form-control" name="qualification" value="${ERP.escapeHtml(t.qualification || '')}"></div>
        <div class="form-group"><label class="form-label">Specialization</label><input class="form-control" name="specialization" value="${ERP.escapeHtml(t.specialization || '')}"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Salary</label><input class="form-control" type="number" name="salary" min="0" value="${t.salary || ''}"></div>
        <div class="form-group"><label class="form-label">Experience (years)</label><input class="form-control" type="number" name="experience_years" min="0" step="0.5" value="${t.experience_years || 0}"></div>
      </div>
      <div class="form-group"><label class="form-label">Join Date</label><input class="form-control" type="date" name="join_date" value="${(t.join_date || '').slice(0,10)}"></div>
    `;
    const { close } = ERP.modal({
      title: `✏️ Edit ${t.full_name}`,
      body,
      size: 'lg',
      footer: `<button class="btn btn-ghost" id="teacherCancelBtn">Cancel</button><button class="btn btn-primary" id="teacherEditBtn">Save Changes</button>`
    });
    document.getElementById('teacherCancelBtn').addEventListener('click', close);
    document.getElementById('teacherEditBtn').addEventListener('click', () => submitTeacher(t.id, close));
  }
  async function submitTeacher(id, closeFn) {
    const modalBody = document.querySelector('.modal-overlay .modal-body');
    const inputs = modalBody.querySelectorAll('[name]');
    const data = {};
    inputs.forEach(i => { data[i.name] = i.value; });
    const url = id ? '/api/admin/teachers/' + id : '/api/admin/teachers';
    const method = id ? 'PUT' : 'POST';
    const btn = document.getElementById(id ? 'teacherEditBtn' : 'teacherSaveBtn');
    if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }
    try {
      const res = await ERP.api(url, { method, body: data });
      ERP.toast('Success', res.message || (id ? 'Teacher updated.' : 'Teacher created.'), 'success');
      setTimeout(() => location.reload(), 700);
    } catch (err) { ERP.toast('Error', err.message, 'error'); if (btn) { btn.disabled = false; btn.textContent = id ? 'Save Changes' : 'Create Teacher'; } }
  }
  function deleteTeacher(id, name) {
    ERP.confirmDialog('Delete Teacher', `Are you sure you want to delete <strong>${name}</strong>? This will also remove class assignments.`, async () => {
      try {
        const res = await ERP.api('/api/admin/teachers/' + id, { method: 'DELETE' });
        ERP.toast('Deleted', res.message || 'Teacher removed.', 'success');
        setTimeout(() => location.reload(), 700);
      } catch (err) { ERP.toast('Error', err.message, 'error'); }
    }, { okText: 'Delete', danger: true });
  }
  function exportTeachers() {
    const rows = <%- JSON.stringify(teachers.map(t => ({emp:t.employee_id, name:t.full_name, email:t.email, phone:t.phone||'', dept:t.dept_code||'', designation:t.designation||'', exp:t.experience_years||0, salary:t.salary||0, classes:t.class_count||0, status:t.is_active?'Active':'Inactive'}))) %>;
    const csv = ['EmployeeID,Name,Email,Phone,Dept,Designation,Experience,Salary,Classes,Status'].concat(rows.map(r => [r.emp,r.name,r.email,r.phone,r.dept,r.designation,r.exp,r.salary,r.classes,r.status].map(x => `"${x}"`).join(','))).join('\n');
    const blob = new Blob([csv], {type:'text/csv'}); const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = 'teachers.csv'; a.click();
    ERP.toast('Exported', 'teachers.csv downloaded.', 'success');
  }
</script>
<%- include('../partials/layout-bottom') %>
