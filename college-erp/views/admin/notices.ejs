<%- include('../partials/layout-top') %>
<%
  const totalNotices = notices.length;
  const pinned = notices.filter(n => n.is_pinned).length;
  const urgent = notices.filter(n => n.priority === 'urgent').length;
  const weekAgo = new Date(Date.now() - 7 * 86400000);
  const thisWeek = notices.filter(n => new Date(n.created_at) >= weekAgo).length;
  const priorityBadge = (p) => ({ urgent: 'badge-danger', high: 'badge-warning', normal: 'badge-info', low: 'badge-neutral' }[p] || 'badge-neutral');
  const categoryBadge = (c) => ({ general: 'badge-neutral', exam: 'badge-info', event: 'badge-purple', holiday: 'badge-warning', fee: 'badge-success', attendance: 'badge-info', urgent: 'badge-danger' }[c] || 'badge-neutral');
  const categoryIcon = { general: '📢', exam: '📝', event: '🎉', holiday: '🌴', fee: '💰', attendance: '📋', urgent: '🚨' };
%>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Announcements</div>
    <h1>Notices & Announcements</h1>
    <p>Broadcast notices to <%= collegeName %>'s students, faculty and staff — pin important updates and track engagement.</p>
    <div class="hero-stat">
      <div class="num"><%= totalNotices %></div>
      <div class="lbl">Total Notices</div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📢</div>
    <div style="flex:1">
      <div class="stat-label">Total Notices</div>
      <div class="stat-value"><%= totalNotices %></div>
      <div class="stat-delta up">▲ Posted all-time</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon amber">📌</div>
    <div style="flex:1">
      <div class="stat-label">Pinned</div>
      <div class="stat-value"><%= pinned %></div>
      <div class="stat-delta up">▲ Top-priority notices</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon red" style="background:linear-gradient(135deg,#ef4444,#f87171);box-shadow:0 6px 16px rgba(239,68,68,.35)">🚨</div>
    <div style="flex:1">
      <div class="stat-label">Urgent</div>
      <div class="stat-value"><%= urgent %></div>
      <div class="stat-delta up">▲ Critical alerts</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon green">📅</div>
    <div style="flex:1">
      <div class="stat-label">This Week</div>
      <div class="stat-value"><%= thisWeek %></div>
      <div class="stat-delta up">▲ New in last 7 days</div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <div class="card-title">All Notices</div>
    <button class="btn btn-primary btn-sm" onclick="openAddNotice()">➕ Post Notice</button>
  </div>
  <div class="card-body" style="padding:0">
    <% if (!notices.length) { %>
      <div class="empty"><div class="empty-icon">📢</div><div class="empty-title">No notices posted</div><div class="empty-sub">Post your first announcement to keep the campus informed.</div></div>
    <% } else { %>
      <div style="max-height:680px;overflow-y:auto">
        <% notices.slice().sort((a, b) => (b.is_pinned ? 1 : 0) - (a.is_pinned ? 1 : 0) || new Date(b.created_at) - new Date(a.created_at)).forEach(n => { %>
          <div style="display:flex;gap:14px;padding:16px 20px;border-bottom:1px solid var(--border);<%= n.is_pinned ? 'background:#fffbeb;' : '' %>">
            <div style="width:40px;height:40px;border-radius:10px;background:var(--brand-50);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0"><%= categoryIcon[n.category] || '📢' %></div>
            <div style="flex:1;min-width:0">
              <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:6px">
                <% if (n.is_pinned) { %><span style="font-size:14px">📌</span><% } %>
                <strong style="font-size:14px;color:var(--gray-900);flex:1"><%= n.title %></strong>
                <span class="badge <%= priorityBadge(n.priority) %>"><%= (n.priority || 'normal').toUpperCase() %></span>
                <span class="badge <%= categoryBadge(n.category) %>"><%= n.category %></span>
                <span class="badge badge-neutral"><%= (n.target_audience || 'all') %></span>
              </div>
              <div class="text-sm" style="color:var(--gray-600);margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden"><%= n.content %></div>
              <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px">
                <div class="text-xs text-muted">📝 by <strong style="color:var(--gray-700)"><%= n.posted_by_name || 'System' %></strong> · <%= helpers.timeAgo(n.created_at) %><% if (n.expires_at) { %> · expires <%= helpers.formatDate(n.expires_at) %><% } %></div>
                <div style="display:flex;gap:4px">
                  <button class="btn btn-ghost btn-sm" onclick='editNotice(<%- JSON.stringify(n) %>)'>✏️ Edit</button>
                  <button class="btn btn-ghost btn-sm" style="color:var(--danger)" onclick="deleteNotice(<%= n.id %>, '<%= helpers.escapeHtml(n.title) %>')">🗑️</button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
  const CATEGORIES = [
    { value: 'general', label: 'General' }, { value: 'exam', label: 'Exam' }, { value: 'event', label: 'Event' },
    { value: 'holiday', label: 'Holiday' }, { value: 'fee', label: 'Fee' }, { value: 'attendance', label: 'Attendance' }, { value: 'urgent', label: 'Urgent' }
  ];
  const AUDIENCES = [{ value: 'all', label: 'All' }, { value: 'admin', label: 'Admins' }, { value: 'teacher', label: 'Teachers' }, { value: 'student', label: 'Students' }];
  const PRIORITIES = [{ value: 'low', label: 'Low' }, { value: 'normal', label: 'Normal' }, { value: 'high', label: 'High' }, { value: 'urgent', label: 'Urgent' }];
  function noticeForm(n) {
    n = n || {};
    const catOpts = CATEGORIES.map(c => `<option value="${c.value}" ${c.value === n.category ? 'selected' : ''}>${c.label}</option>`).join('');
    const audOpts = AUDIENCES.map(a => `<option value="${a.value}" ${a.value === n.target_audience ? 'selected' : ''}>${a.label}</option>`).join('');
    const priOpts = PRIORITIES.map(p => `<option value="${p.value}" ${p.value === n.priority ? 'selected' : ''}>${p.label}</option>`).join('');
    return `
      <div class="form-group"><label class="form-label">Title <span class="req">*</span></label><input class="form-control" name="title" value="${ERP.escapeHtml(n.title || '')}" required></div>
      <div class="form-group"><label class="form-label">Content <span class="req">*</span></label><textarea class="form-textarea" name="content" required style="min-height:120px">${ERP.escapeHtml(n.content || '')}</textarea></div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Category</label><select class="form-select" name="category">${catOpts}</select></div>
        <div class="form-group"><label class="form-label">Target Audience</label><select class="form-select" name="target_audience">${audOpts}</select></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Priority</label><select class="form-select" name="priority">${priOpts}</select></div>
        <div class="form-group"><label class="form-label">Expires At</label><input class="form-control" type="date" name="expires_at" value="${(n.expires_at || '').slice(0,10)}"></div>
      </div>
      <div class="form-group"><label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px"><input type="checkbox" name="is_pinned" value="1" ${n.is_pinned ? 'checked' : ''} style="width:auto"> 📌 Pin this notice to the top</label></div>
    `;
  }
  function openAddNotice() {
    const { close } = ERP.modal({
      title: '📢 Post New Notice', body: noticeForm(), size: 'lg',
      footer: `<button class="btn btn-ghost" id="noticeCancelBtn">Cancel</button><button class="btn btn-primary" id="noticeSaveBtn">Post Notice</button>`
    });
    document.getElementById('noticeCancelBtn').addEventListener('click', close);
    document.getElementById('noticeSaveBtn').addEventListener('click', () => submitNotice(null, close));
  }
  function editNotice(n) {
    const { close } = ERP.modal({
      title: `✏️ Edit Notice`, body: noticeForm(n), size: 'lg',
      footer: `<button class="btn btn-ghost" id="noticeCancelBtn">Cancel</button><button class="btn btn-primary" id="noticeSaveBtn">Save Changes</button>`
    });
    document.getElementById('noticeCancelBtn').addEventListener('click', close);
    document.getElementById('noticeSaveBtn').addEventListener('click', () => submitNotice(n.id, close));
  }
  async function submitNotice(id, closeFn) {
    const modalBody = document.querySelector('.modal-overlay .modal-body');
    const data = {};
    modalBody.querySelectorAll('[name]').forEach(i => { data[i.name] = i.type === 'checkbox' ? (i.checked ? 1 : 0) : i.value; });
    const url = id ? '/api/admin/notices/' + id : '/api/admin/notices';
    const method = id ? 'PUT' : 'POST';
    const btn = document.getElementById('noticeSaveBtn');
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const res = await ERP.api(url, { method, body: data });
      ERP.toast('Success', res.message || (id ? 'Notice updated.' : 'Notice posted.'), 'success');
      setTimeout(() => location.reload(), 700);
    } catch (err) { ERP.toast('Error', err.message, 'error'); btn.disabled = false; btn.textContent = id ? 'Save Changes' : 'Post Notice'; }
  }
  function deleteNotice(id, title) {
    ERP.confirmDialog('Delete Notice', `Delete "<strong>${title}</strong>"? This action cannot be undone.`, async () => {
      try {
        const res = await ERP.api('/api/admin/notices/' + id, { method: 'DELETE' });
        ERP.toast('Deleted', res.message || 'Notice removed.', 'success');
        setTimeout(() => location.reload(), 700);
      } catch (err) { ERP.toast('Error', err.message, 'error'); }
    }, { okText: 'Delete', danger: true });
  }
</script>
<%- include('../partials/layout-bottom') %>
