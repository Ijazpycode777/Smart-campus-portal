<%- include('../partials/layout-top') %>
<%
  const pending = leaves.filter(l => l.status === 'pending').length;
  const approved = leaves.filter(l => l.status === 'approved').length;
  const rejected = leaves.filter(l => l.status === 'rejected').length;
  const statusBadge = { pending: 'warning', approved: 'success', rejected: 'danger' };
  const leaveIcon = { casual: '🌴', sick: '🏥', earned: '⭐', maternity: '👶', personal: '📋' };
  function days(l) {
    return Math.round((new Date(l.end_date) - new Date(l.start_date)) / 86400000) + 1;
  }
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/student">Dashboard</a> / Leave Requests</div>
    <h1>My Leaves</h1>
  </div>
  <button class="btn btn-primary" onclick="openLeaveModal()">➕ Apply for Leave</button>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📋</div>
    <div style="flex:1">
      <div class="stat-label">Total Requests</div>
      <div class="stat-value"><%= leaves.length %></div>
      <div class="stat-delta up">▲ Submitted</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon amber">⏳</div>
    <div style="flex:1">
      <div class="stat-label">Pending</div>
      <div class="stat-value"><%= pending %></div>
      <div class="stat-delta up">▲ Awaiting review</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon green">✅</div>
    <div style="flex:1">
      <div class="stat-label">Approved</div>
      <div class="stat-value"><%= approved %></div>
      <div class="stat-delta up">▲ Granted</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon red">❌</div>
    <div style="flex:1">
      <div class="stat-label">Rejected</div>
      <div class="stat-value"><%= rejected %></div>
      <div class="stat-delta down">▼ Declined</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">Leave History</div>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Type</th><th>Duration</th><th>Dates</th><th>Reason</th><th>Applied On</th><th>Status</th><th>Reviewed</th></tr></thead>
      <tbody>
        <% if (!leaves.length) { %>
          <tr><td colspan="7"><div class="empty"><div class="empty-icon">🌴</div><div class="empty-title">No leave requests yet</div><div class="empty-sub">Apply for a leave using the button above.</div></div></td></tr>
        <% } %>
        <% leaves.forEach(l => { %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:8px">
                <span style="font-size:18px"><%= leaveIcon[l.leave_type] || '📋' %></span>
                <strong style="text-transform:capitalize"><%= l.leave_type %></strong>
              </div>
            </td>
            <td><span class="badge badge-info"><%= days(l) %> day<%= days(l) > 1 ? 's' : '' %></span></td>
            <td>
              <div style="font-weight:600"><%= helpers.formatDate(l.start_date) %></div>
              <div class="text-xs text-muted">to <%= helpers.formatDate(l.end_date) %></div>
            </td>
            <td style="max-width:280px"><div class="text-sm truncate" style="color:var(--gray-600)"><%= l.reason %></div></td>
            <td class="text-xs text-muted"><%= helpers.formatDate(l.created_at) %></td>
            <td><span class="badge badge-<%= statusBadge[l.status] %>"><%= l.status %></span></td>
            <td class="text-xs text-muted"><%= l.reviewed_at ? helpers.formatDateTime(l.reviewed_at) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Leave Application Modal -->
<div class="modal-overlay hidden" id="leaveModal" style="display:none">
  <div class="modal modal-md">
    <div class="modal-header">
      <div class="modal-title">➕ Apply for Leave</div>
      <button class="icon-btn" onclick="document.getElementById('leaveModal').style.display='none'">×</button>
    </div>
    <form id="leaveForm" onsubmit="submitLeave(event)">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Leave Type <span class="req">*</span></label>
          <select class="form-select" name="leave_type" required>
            <option value="casual">🌴 Casual Leave</option>
            <option value="sick">🏥 Sick Leave</option>
            <option value="earned">⭐ Earned Leave</option>
            <option value="personal">📋 Personal Leave</option>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Start Date <span class="req">*</span></label>
            <input class="form-control" type="date" name="start_date" required onchange="syncEnd()">
          </div>
          <div class="form-group">
            <label class="form-label">End Date <span class="req">*</span></label>
            <input class="form-control" type="date" name="end_date" id="endDate" required>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Reason <span class="req">*</span></label>
          <textarea class="form-textarea" name="reason" rows="4" placeholder="Explain the reason for your leave request" required></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('leaveModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Submit Request</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openLeaveModal() { document.getElementById('leaveModal').style.display = 'flex'; }
  function syncEnd() {
    const start = document.querySelector('[name=start_date]').value;
    const end = document.getElementById('endDate');
    if (!end.value || end.value < start) end.value = start;
  }
  async function submitLeave(e) {
    e.preventDefault();
    const fd = new FormData(e.target);
    const body = {
      leave_type: fd.get('leave_type'),
      start_date: fd.get('start_date'),
      end_date: fd.get('end_date'),
      reason: fd.get('reason')
    };
    try {
      const res = await ERP.api('/api/student/leave-requests', { method: 'POST', body });
      ERP.toast('Submitted', res.message || 'Leave request submitted.', 'success');
      setTimeout(() => location.reload(), 800);
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
  }
</script>
<%- include('../partials/layout-bottom') %>
