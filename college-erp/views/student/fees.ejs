<%- include('../partials/layout-top') %>
<%
  const collPct = totalAll ? Math.round((totalPaid / totalAll) * 100) : 0;
  const statusBadge = { paid: 'success', unpaid: 'danger', partially_paid: 'warning' };
  const statusLabel = { paid: 'Paid', unpaid: 'Unpaid', partially_paid: 'Partially Paid' };
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/student">Dashboard</a> / Fees</div>
    <h1>My Fees</h1>
  </div>
</div>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Fee Collection Progress</div>
    <h1><%= helpers.formatCurrency(totalPaid) %> / <%= helpers.formatCurrency(totalAll) %></h1>
    <p><%= collPct %>% of total fees paid · Outstanding due: <%= helpers.formatCurrency(totalDue) %></p>
    <div class="hero-stat">
      <div class="num"><%= collPct %>%</div>
      <div class="lbl">Paid</div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">💼</div>
    <div style="flex:1">
      <div class="stat-label">Total Billed</div>
      <div class="stat-value"><%= helpers.formatCurrency(totalAll) %></div>
      <div class="stat-delta up">▲ Across all invoices</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">✅</div>
    <div style="flex:1">
      <div class="stat-label">Total Paid</div>
      <div class="stat-value"><%= helpers.formatCurrency(totalPaid) %></div>
      <div class="stat-delta up">▲ Cleared so far</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon red">⏳</div>
    <div style="flex:1">
      <div class="stat-label">Total Due</div>
      <div class="stat-value"><%= helpers.formatCurrency(totalDue) %></div>
      <div class="stat-delta down">▼ Pending payment</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon amber">🧾</div>
    <div style="flex:1">
      <div class="stat-label">Invoices</div>
      <div class="stat-value"><%= invoices.length %></div>
      <div class="stat-delta up">▲ Generated</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Invoices</div>
      <div class="text-xs text-muted">Pay any outstanding balance online</div>
    </div>
    <svg data-ring="<%= collPct %>" data-ring-color="#10b981" data-ring-size="48" style="width:48px;height:48px"></svg>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Invoice #</th><th>Semester</th><th>Academic Year</th><th>Total</th><th>Paid</th><th>Due Date</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% if (!invoices.length) { %>
          <tr><td colspan="8"><div class="empty"><div class="empty-icon">🧾</div><div class="empty-title">No invoices</div><div class="empty-sub">Your fee invoices will appear here.</div></div></td></tr>
        <% } %>
        <% invoices.forEach(inv => {
          const remaining = inv.total_amount - inv.paid_amount;
          const canPay = inv.status !== 'paid' && remaining > 0;
        %>
          <tr>
            <td><strong><%= inv.invoice_number %></strong></td>
            <td>Sem <%= inv.semester %></td>
            <td class="text-xs text-muted"><%= inv.academic_year %></td>
            <td><strong><%= helpers.formatCurrency(inv.total_amount) %></strong></td>
            <td><span style="color:var(--success);font-weight:700"><%= helpers.formatCurrency(inv.paid_amount) %></span>
              <% if (remaining > 0) { %><div class="text-xs text-muted">due <%= helpers.formatCurrency(remaining) %></div><% } %>
            </td>
            <td class="text-xs text-muted"><%= helpers.formatDate(inv.due_date) %></td>
            <td><span class="badge badge-<%= statusBadge[inv.status] || 'neutral' %>"><%= statusLabel[inv.status] || inv.status %></span></td>
            <td>
              <% if (canPay) { %>
                <button class="btn btn-primary btn-sm" onclick="openPay(<%= inv.id %>, '<%= inv.invoice_number %>', <%= remaining %>)">💳 Pay Now</button>
              <% } else { %>
                <span class="badge badge-success badge-dot">Settled</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">Payment History</div>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Invoice #</th><th>Amount</th><th>Method</th><th>Transaction ID</th><th>Date</th></tr></thead>
      <tbody>
        <% if (!payments.length) { %>
          <tr><td colspan="5"><div class="empty"><div class="empty-icon">💳</div><div class="empty-title">No payments yet</div></div></td></tr>
        <% } %>
        <% payments.forEach(p => { %>
          <tr>
            <td><strong><%= p.invoice_number %></strong></td>
            <td><span style="color:var(--success);font-weight:700"><%= helpers.formatCurrency(p.amount) %></span></td>
            <td><span class="badge badge-neutral"><%= p.payment_method %></span></td>
            <td class="text-xs text-muted"><%= p.transaction_id || '—' %></td>
            <td class="text-xs text-muted"><%= helpers.formatDateTime(p.payment_date) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Payment Modal -->
<div class="modal-overlay hidden" id="payModal" style="display:none">
  <div class="modal modal-md">
    <div class="modal-header">
      <div class="modal-title">💳 Make Payment</div>
      <button class="icon-btn" onclick="document.getElementById('payModal').style.display='none'">×</button>
    </div>
    <form id="payForm" onsubmit="submitPayment(event)">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Invoice</label>
          <div style="font-weight:700" id="payInvoice">—</div>
        </div>
        <div class="form-group">
          <label class="form-label">Amount <span class="req">*</span></label>
          <input class="form-control" type="number" name="amount" id="payAmount" min="1" step="0.01" required>
          <div class="form-hint">Outstanding balance auto-filled — adjust as needed</div>
        </div>
        <div class="form-group">
          <label class="form-label">Payment Method <span class="req">*</span></label>
          <select class="form-select" name="payment_method" required>
            <option value="Online Banking">🏦 Online Banking</option>
            <option value="Credit Card">💳 Credit Card</option>
            <option value="Debit Card">💳 Debit Card</option>
            <option value="UPI">📱 UPI</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('payModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Pay Now</button>
      </div>
    </form>
  </div>
</div>

<script>
  let currentInvoiceId = null;
  function openPay(id, invoiceNumber, remaining) {
    currentInvoiceId = id;
    document.getElementById('payInvoice').textContent = invoiceNumber + ' · Outstanding ' + '<%= currencySymbol %>' + remaining.toFixed(2);
    document.getElementById('payAmount').value = remaining.toFixed(2);
    document.getElementById('payAmount').max = remaining.toFixed(2);
    document.getElementById('payModal').style.display = 'flex';
  }
  async function submitPayment(e) {
    e.preventDefault();
    const fd = new FormData(e.target);
    const body = { amount: parseFloat(fd.get('amount')), payment_method: fd.get('payment_method') };
    try {
      const res = await ERP.api('/api/student/fees/' + currentInvoiceId + '/pay', { method: 'POST', body });
      ERP.toast('Payment Successful', res.message || 'Your payment has been recorded.', 'success');
      setTimeout(() => location.reload(), 900);
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
  }
</script>
<%- include('../partials/layout-bottom') %>
