<%- include('../partials/layout-top') %>
<%
  const typeIcon = { document: '📄', video: '🎬', link: '🔗', assignment: '📝' };
  const typeColor = { document: 'blue', video: 'purple', link: 'green', assignment: 'amber' };
  function fmtSize(bytes) {
    if (!bytes) return '—';
    const kb = bytes / 1024;
    if (kb < 1024) return Math.round(kb) + ' KB';
    return (kb / 1024).toFixed(1) + ' MB';
  }
  const subjects = Array.from(new Set(materials.map(m => m.subject_code).filter(Boolean)));
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/student">Dashboard</a> / Materials</div>
    <h1>Study Materials</h1>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📦</div>
    <div style="flex:1">
      <div class="stat-label">Total Materials</div>
      <div class="stat-value"><%= materials.length %></div>
      <div class="stat-delta up">▲ Available to you</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">📄</div>
    <div style="flex:1">
      <div class="stat-label">Documents</div>
      <div class="stat-value"><%= materials.filter(m => m.material_type === 'document').length %></div>
      <div class="stat-delta up">▲ Notes / PDFs</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon violet">🎬</div>
    <div style="flex:1">
      <div class="stat-label">Videos</div>
      <div class="stat-value"><%= materials.filter(m => m.material_type === 'video').length %></div>
      <div class="stat-delta up">▲ Recorded lectures</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon amber">📚</div>
    <div style="flex:1">
      <div class="stat-label">Subjects</div>
      <div class="stat-value"><%= subjects.length %></div>
      <div class="stat-delta up">▲ With materials</div>
    </div>
  </div>
</div>

<% if (subjects.length) { %>
  <div class="card mb-4">
    <div class="card-body" style="padding:14px 18px">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span class="text-xs text-muted" style="margin-right:6px">Filter by subject:</span>
        <button class="btn btn-primary btn-sm filter-subject active" data-sub="all">All</button>
        <% subjects.forEach(sub => { %>
          <button class="btn btn-ghost btn-sm filter-subject" data-sub="<%= sub %>"><%= sub %></button>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header">
    <div class="card-title">All Materials</div>
  </div>
  <div class="card-body">
    <% if (!materials.length) { %>
      <div class="empty"><div class="empty-icon">📦</div><div class="empty-title">No materials available</div><div class="empty-sub">Materials uploaded by your teachers will appear here.</div></div>
    <% } else { %>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
        <% materials.forEach(m => { %>
          <div class="stat-card material-card" data-sub="<%= m.subject_code %>" style="display:block;padding:18px">
            <div style="display:flex;align-items:flex-start;gap:12px">
              <div class="stat-icon <%= typeColor[m.material_type] || 'brand' %>" style="width:42px;height:42px;font-size:20px"><%= typeIcon[m.material_type] || '📦' %></div>
              <div style="flex:1;min-width:0">
                <div style="font-weight:800;font-size:14px" class="truncate"><%= m.title %></div>
                <div class="text-xs text-muted truncate" style="margin-top:2px"><%= m.subject_code %> · <%= m.class_name %></div>
              </div>
            </div>
            <div style="font-size:12px;color:var(--gray-600);margin:12px 0;line-height:1.5"><%= (m.description || 'No description').slice(0, 110) %><% if ((m.description||'').length > 110) { %>…<% } %></div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin:10px 0">
              <span class="badge badge-<%= typeColor[m.material_type] || 'neutral' %>"><%= m.material_type %></span>
              <span class="badge badge-neutral">💾 <%= fmtSize(m.file_size) %></span>
            </div>
            <div class="text-xs text-muted" style="margin-bottom:10px">By <%= m.uploaded_by_name || 'Teacher' %> · <%= helpers.timeAgo(m.created_at) %></div>
            <% if (m.file_url) { %>
              <a href="<%= m.file_url %>" target="_blank" class="btn btn-primary btn-block" style="justify-content:center">📖 Open Material</a>
            <% } else { %>
              <button class="btn btn-ghost btn-block" disabled style="justify-content:center;color:var(--gray-400)">No link available</button>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.querySelectorAll('.filter-subject').forEach(p => {
    p.addEventListener('click', () => {
      document.querySelectorAll('.filter-subject').forEach(x => { x.classList.remove('active'); x.classList.add('btn-ghost'); x.classList.remove('btn-primary'); });
      p.classList.add('active'); p.classList.remove('btn-ghost'); p.classList.add('btn-primary');
      const sub = p.getAttribute('data-sub');
      document.querySelectorAll('.material-card').forEach(c => {
        c.style.display = (sub === 'all' || c.getAttribute('data-sub') === sub) ? '' : 'none';
      });
    });
  });
</script>
<%- include('../partials/layout-bottom') %>
