<%- include('../partials/layout-top') %>
<%
  const unread = notifications.filter(n => !n.is_read).length;
  const typeIcon = { info: 'ℹ️', success: '✅', warning: '⚠️', error: '❌', announcement: '📢' };
  const typeColor = { info: 'info', success: 'success', warning: 'warning', error: 'danger', announcement: 'purple' };
  const types = Array.from(new Set(notifications.map(n => n.type).filter(Boolean)));
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/student">Dashboard</a> / Notifications</div>
    <h1>Notifications</h1>
  </div>
  <% if (unread) { %>
    <button class="btn btn-ghost" onclick="markAllRead()">✓ Mark all as read</button>
  <% } %>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">🔔</div>
    <div style="flex:1">
      <div class="stat-label">Total Notifications</div>
      <div class="stat-value"><%= notifications.length %></div>
      <div class="stat-delta up">▲ Received</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon amber">📩</div>
    <div style="flex:1">
      <div class="stat-label">Unread</div>
      <div class="stat-value"><%= unread %></div>
      <div class="stat-delta up">▲ Awaiting your attention</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon green">✅</div>
    <div style="flex:1">
      <div class="stat-label">Read</div>
      <div class="stat-value"><%= notifications.length - unread %></div>
      <div class="stat-delta up">▲ Already seen</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon red">🚨</div>
    <div style="flex:1">
      <div class="stat-label">Alerts</div>
      <div class="stat-value"><%= notifications.filter(n => n.type === 'error' || n.type === 'warning').length %></div>
      <div class="stat-delta up">▲ Warnings & errors</div>
    </div>
  </div>
</div>

<% if (types.length) { %>
  <div class="card mb-4">
    <div class="card-body" style="padding:14px 18px">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span class="text-xs text-muted" style="margin-right:6px">Filter by type:</span>
        <button class="btn btn-primary btn-sm filter-type active" data-type="all">All</button>
        <% types.forEach(t => { %>
          <button class="btn btn-ghost btn-sm filter-type" data-type="<%= t %>"><%= typeIcon[t] || '🔔' %> <%= t %></button>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header">
    <div class="card-title">All Notifications</div>
    <% if (unread) { %><span class="badge badge-warning badge-dot"><%= unread %> unread</span><% } %>
  </div>
  <div class="card-body" style="padding:0">
    <% if (!notifications.length) { %>
      <div class="empty"><div class="empty-icon">🔔</div><div class="empty-title">No notifications</div><div class="empty-sub">You're all caught up.</div></div>
    <% } else { %>
      <div style="max-height:680px;overflow-y:auto">
        <% notifications.forEach(n => { %>
          <div class="notif-row" data-type="<%= n.type %>" style="display:flex;gap:12px;padding:16px 20px;border-bottom:1px solid var(--border);align-items:flex-start<%= !n.is_read ? ';background:linear-gradient(90deg,rgba(99,102,241,.04),transparent)' : '' %>">
            <div class="stat-icon <%= typeColor[n.type] || 'neutral' %>" style="width:38px;height:38px;font-size:18px;flex-shrink:0"><%= typeIcon[n.type] || '🔔' %></div>
            <div style="flex:1;min-width:0">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
                <% if (!n.is_read) { %><span style="width:8px;height:8px;background:var(--brand-600);border-radius:50%;flex-shrink:0"></span><% } %>
                <strong style="font-size:14px;flex:1;<%= !n.is_read ? '' : 'color:var(--gray-700)' %>"><%= n.title %></strong>
                <span class="badge badge-<%= typeColor[n.type] || 'neutral' %>"><%= n.type %></span>
              </div>
              <div style="font-size:13px;color:var(--gray-600);line-height:1.5"><%= n.message %></div>
              <div style="display:flex;align-items:center;gap:12px;margin-top:8px">
                <span class="text-xs text-muted"><%= helpers.timeAgo(n.created_at) %></span>
                <% if (!n.is_read) { %>
                  <button class="btn btn-ghost btn-sm" onclick="markRead(<%= n.id %>)">✓ Mark as read</button>
                <% } %>
                <% if (n.link) { %>
                  <a href="<%= n.link %>" class="btn btn-ghost btn-sm" style="color:var(--brand-600)">View →</a>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.querySelectorAll('.filter-type').forEach(p => {
    p.addEventListener('click', () => {
      document.querySelectorAll('.filter-type').forEach(x => { x.classList.remove('active'); x.classList.add('btn-ghost'); x.classList.remove('btn-primary'); });
      p.classList.add('active'); p.classList.remove('btn-ghost'); p.classList.add('btn-primary');
      const t = p.getAttribute('data-type');
      document.querySelectorAll('.notif-row').forEach(r => {
        r.style.display = (t === 'all' || r.getAttribute('data-type') === t) ? '' : 'none';
      });
    });
  });
  async function markRead(id) {
    try {
      const res = await ERP.api('/api/notifications/' + id + '/read', { method: 'POST' });
      ERP.toast('Marked', res.message || 'Notification marked as read.', 'success');
      setTimeout(() => location.reload(), 700);
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
  }
  async function markAllRead() {
    try {
      const res = await ERP.api('/api/notifications/read-all', { method: 'POST' });
      ERP.toast('Done', res.message || 'All notifications marked as read.', 'success');
      setTimeout(() => location.reload(), 700);
    } catch (err) { ERP.toast('Error', err.message, 'error'); }
  }
</script>
<%- include('../partials/layout-bottom') %>
