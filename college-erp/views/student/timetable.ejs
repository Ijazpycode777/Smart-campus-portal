<%- include('../partials/layout-top') %>
<%
  const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
  const dayShort = { Monday: 'Mon', Tuesday: 'Tue', Wednesday: 'Wed', Thursday: 'Thu', Friday: 'Fri', Saturday: 'Sat', Sunday: 'Sun' };
  const todayName = new Date().toLocaleDateString('en-US', { weekday: 'long' });

  const allEntries = [];
  Object.keys(byDay || {}).forEach(d => { (byDay[d] || []).forEach(e => allEntries.push({ ...e, day: d })); });
  const slotSet = new Set();
  allEntries.forEach(e => slotSet.add(`${e.start_time}-${e.end_time}`));
  const slots = Array.from(slotSet).sort();
  const slotLabel = (slot) => {
    const [s, e] = slot.split('-');
    return `${s.slice(0,5)} - ${e.slice(0,5)}`;
  };
  const entryFor = (day, slot) => (byDay[day] || []).find(e => `${e.start_time}-${e.end_time}` === slot);

  const totalClasses = allEntries.length;
  const subjectSet = new Set(allEntries.map(e => e.subject_code));
  const activeDays = days.filter(d => (byDay[d] || []).length > 0).length;
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/student">Dashboard</a> / Timetable</div>
    <h1>My Weekly Timetable</h1>
  </div>
  <span class="badge badge-info badge-dot">Today is <%= todayName %></span>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📅</div>
    <div style="flex:1">
      <div class="stat-label">Total Classes / Week</div>
      <div class="stat-value"><%= totalClasses %></div>
      <div class="stat-delta up">▲ Across all days</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">📚</div>
    <div style="flex:1">
      <div class="stat-label">Subjects</div>
      <div class="stat-value"><%= subjectSet.size %></div>
      <div class="stat-delta up">▲ In your curriculum</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">⏰</div>
    <div style="flex:1">
      <div class="stat-label">Time Slots</div>
      <div class="stat-value"><%= slots.length %></div>
      <div class="stat-delta up">▲ Distinct periods</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon pink">🏛️</div>
    <div style="flex:1">
      <div class="stat-label">Active Days</div>
      <div class="stat-value"><%= activeDays %></div>
      <div class="stat-delta up">▲ Out of 7</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Weekly Schedule</div>
      <div class="text-xs text-muted">Monday to Sunday · Highlighted column is today</div>
    </div>
  </div>
  <div class="card-body">
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th style="min-width:120px">Time</th>
            <% days.forEach(d => { %>
              <th style="<%= d === todayName ? 'background:var(--brand-50);color:var(--brand-700)' : '' %>">
                <%= dayShort[d] %><% if (d === todayName) { %> <span class="badge badge-success" style="margin-left:4px">TODAY</span><% } %>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% if (!slots.length) { %>
            <tr><td colspan="8"><div class="empty"><div class="empty-icon">📭</div><div class="empty-title">No timetable entries</div><div class="empty-sub">Your weekly schedule will appear here once published.</div></div></td></tr>
          <% } %>
          <% slots.forEach(slot => { %>
            <tr>
              <td style="font-weight:700;background:var(--surface-2);font-size:12px;color:var(--gray-700)"><%= slotLabel(slot) %></td>
              <% days.forEach(d => {
                const e = entryFor(d, slot);
              %>
                <td style="<%= d === todayName ? 'background:var(--brand-50)' : '' %>">
                  <% if (e) { %>
                    <div style="padding:8px;border-radius:8px;background:linear-gradient(135deg,#eef2ff 0%,#faf5ff 100%);border-left:3px solid #6366f1">
                      <div style="font-weight:700;font-size:12px" class="truncate"><%= e.subject_name %></div>
                      <div class="text-xs text-muted" style="margin-top:2px"><%= e.subject_code %></div>
                      <div class="text-xs text-muted" style="margin-top:2px">📍 <%= e.room %></div>
                      <div class="text-xs" style="margin-top:2px;color:var(--brand-600);font-weight:600" class="truncate"><%= e.teacher_name %></div>
                    </div>
                  <% } else { %>
                    <div style="padding:8px;color:var(--gray-300);text-align:center;font-size:18px">—</div>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/layout-bottom') %>
