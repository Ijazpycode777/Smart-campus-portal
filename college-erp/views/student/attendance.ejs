<%- include('../partials/layout-top') %>
<%
  const total = overall.total || 0;
  const present = overall.present || 0;
  const absent = overall.absent || 0;
  const late = overall.late || 0;
  const excused = overall.excused || 0;
  const pct = total ? Math.round((present / total) * 100) : 0;
  function statusBadge(s) {
    const m = { present: 'success', absent: 'danger', late: 'warning', excused: 'info' };
    return m[s] || 'neutral';
  }
  function subPct(s) { return s.total ? Math.round((s.present / s.total) * 100) : 0; }
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/student">Dashboard</a> / Attendance</div>
    <h1>My Attendance</h1>
  </div>
</div>

<div class="charts-grid" style="grid-template-columns:1fr 2fr">
  <div class="card">
    <div class="card-header"><div class="card-title">Overall Attendance</div></div>
    <div class="card-body" style="text-align:center;padding:24px">
      <svg data-ring="<%= pct %>" data-ring-color="<%= pct >= 75 ? '#10b981' : pct >= 50 ? '#f59e0b' : '#ef4444' %>" data-ring-size="160" style="width:160px;height:160px;margin:0 auto"></svg>
      <div style="margin-top:16px;font-size:36px;font-weight:800;color:<%= pct >= 75 ? 'var(--success)' : pct >= 50 ? 'var(--accent-amber)' : 'var(--danger)' %>"><%= pct %>%</div>
      <div class="text-xs text-muted"><%= present %> of <%= total %> classes attended</div>
      <div style="margin-top:14px;padding:10px;background:var(--surface-2);border-radius:8px;font-size:13px">
        <% if (pct >= 75) { %><strong style="color:var(--success)">✓ Eligible for exams</strong><% } else { %><strong style="color:var(--danger)">⚠ Below 75% — exam eligibility at risk</strong><% } %>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">Monthly Trend</div>
        <div class="text-xs text-muted">Attendance % over the last few months</div>
      </div>
    </div>
    <div class="card-body">
      <% if (!monthly.length) { %>
        <div class="empty"><div class="empty-icon">📈</div><div class="empty-title">No monthly data</div></div>
      <% } else { %>
        <canvas data-chart="line" data-data='<%= JSON.stringify(monthly.map(m => ({ label: m.month, value: m.pct }))) %>' style="width:100%;height:260px"></canvas>
      <% } %>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📚</div>
    <div style="flex:1">
      <div class="stat-label">Total Classes</div>
      <div class="stat-value"><%= total %></div>
      <div class="stat-delta up">▲ Held so far</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">✅</div>
    <div style="flex:1">
      <div class="stat-label">Present</div>
      <div class="stat-value"><%= present %></div>
      <div class="stat-delta up">▲ Attended</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon red">❌</div>
    <div style="flex:1">
      <div class="stat-label">Absent</div>
      <div class="stat-value"><%= absent %></div>
      <div class="stat-delta down">▼ Missed</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon amber">⏰</div>
    <div style="flex:1">
      <div class="stat-label">Late</div>
      <div class="stat-value"><%= late %></div>
      <div class="stat-delta up">▲ Late arrivals</div>
    </div>
  </div>
</div>

<div class="charts-grid" style="grid-template-columns:1.4fr 1fr">
  <div class="card">
    <div class="card-header">
      <div class="card-title">Per-Subject Attendance</div>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Subject Code</th><th>Subject</th><th>Total</th><th>Present</th><th>Absent</th><th>Rate</th></tr></thead>
        <tbody>
          <% if (!bySubject.length) { %>
            <tr><td colspan="6"><div class="empty"><div class="empty-title">No subject data</div></div></td></tr>
          <% } %>
          <% bySubject.forEach(s => { const p = subPct(s); %>
            <tr>
              <td><strong><%= s.code %></strong></td>
              <td><%= s.name %></td>
              <td><%= s.total %></td>
              <td><span class="badge badge-success"><%= s.present %></span></td>
              <td><span class="badge badge-danger"><%= s.absent %></span></td>
              <td>
                <div style="display:flex;align-items:center;gap:8px">
                  <div style="width:60px;height:6px;background:var(--surface-2);border-radius:3px;overflow:hidden">
                    <div style="width:<%= p %>%;height:100%;background:<%= p >= 75 ? '#10b981' : p >= 50 ? '#f59e0b' : '#ef4444' %>"></div>
                  </div>
                  <span class="badge <%= p >= 75 ? 'badge-success' : p >= 50 ? 'badge-warning' : 'badge-danger' %>"><%= p %>%</span>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">Recent Records</div>
    </div>
    <div class="card-body" style="padding:0">
      <div style="max-height:380px;overflow-y:auto">
        <% if (!recent.length) { %>
          <div class="empty"><div class="empty-title">No recent records</div></div>
        <% } else { %>
          <% recent.forEach(r => { %>
            <div style="display:flex;gap:12px;padding:12px 18px;border-bottom:1px solid var(--border);align-items:center">
              <div style="text-align:center;min-width:46px">
                <div style="font-size:11px;color:var(--gray-500)"><%= helpers.formatDate(r.date).split(' ')[0] %></div>
                <div style="font-weight:800;font-size:14px"><%= new Date(r.date).getDate() %></div>
              </div>
              <div style="flex:1;min-width:0">
                <div style="font-weight:600;font-size:13px" class="truncate"><%= r.subject_name %></div>
                <div class="text-xs text-muted"><%= r.subject_code %> · <%= r.class_name %></div>
              </div>
              <span class="badge badge-<%= statusBadge(r.status) %>"><%= r.status %></span>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/layout-bottom') %>
