<%- include('../partials/layout-top') %>
<%
  function gradeColor(g) {
    if (g === 'A+' || g === 'A') return 'success';
    if (g === 'B+' || g === 'B') return 'info';
    if (g === 'C') return 'warning';
    if (g === 'D') return 'purple';
    return 'danger';
  }
  function gradeHex(g) {
    if (g === 'A+' || g === 'A') return '#10b981';
    if (g === 'B+' || g === 'B') return '#3b82f6';
    if (g === 'C') return '#f59e0b';
    if (g === 'D') return '#f97316';
    return '#ef4444';
  }
  const passed = results.filter(r => r.marks_obtained >= r.passing_marks).length;
  const passRate = results.length ? Math.round(passed / results.length * 100) : 0;
  const examTypeBadge = { midterm: 'info', final: 'danger', quiz: 'warning', assignment: 'purple', practical: 'success' };
  const donutData = Object.entries(gradeDist || {}).map(([grade, count]) => ({ label: grade, value: count, color: gradeHex(grade) }));
%>

<div class="page-head">
  <div>
    <div class="crumbs"><a href="/student">Dashboard</a> / Results</div>
    <h1>Examination Results</h1>
  </div>
</div>

<div class="hero-banner fade-in">
  <div style="position:relative">
    <div style="font-size:11px;opacity:.85;text-transform:uppercase;letter-spacing:.1em;font-weight:600">Academic Performance</div>
    <h1>My Results</h1>
    <p>Across <%= results.length %> examinations · Academic year <%= academicYear %></p>
    <div class="hero-stat">
      <div class="num"><%= gpa || '—' %></div>
      <div class="lbl">Current GPA</div>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card slide-up">
    <div class="stat-icon brand">📝</div>
    <div style="flex:1">
      <div class="stat-label">Total Exams</div>
      <div class="stat-value"><%= results.length %></div>
      <div class="stat-delta up">▲ Results recorded</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.05s">
    <div class="stat-icon green">🎯</div>
    <div style="flex:1">
      <div class="stat-label">GPA</div>
      <div class="stat-value"><%= gpa || '—' %></div>
      <div class="stat-delta up">▲ Out of 10</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.1s">
    <div class="stat-icon amber">📊</div>
    <div style="flex:1">
      <div class="stat-label">Average %</div>
      <div class="stat-value"><%= avgPct || 0 %>%</div>
      <div class="stat-delta up">▲ Across all exams</div>
    </div>
  </div>
  <div class="stat-card slide-up" style="animation-delay:.15s">
    <div class="stat-icon pink">✅</div>
    <div style="flex:1">
      <div class="stat-label">Pass Rate</div>
      <div class="stat-value"><%= passRate %>%</div>
      <div class="stat-delta up">▲ <%= passed %>/<%= results.length %> passed</div>
    </div>
  </div>
</div>

<div class="charts-grid" style="grid-template-columns:1fr 1.5fr">
  <div class="card">
    <div class="card-header">
      <div class="card-title">Grade Distribution</div>
    </div>
    <div class="card-body" style="text-align:center">
      <% if (!donutData.length) { %>
        <div class="empty"><div class="empty-icon">📊</div><div class="empty-title">No grades yet</div></div>
      <% } else { %>
        <canvas data-chart="donut" data-data='<%= JSON.stringify(donutData) %>' data-opts='<%= JSON.stringify({ centerLabel: "Grades", centerValue: String(results.length) }) %>' style="width:100%;height:240px"></canvas>
        <div style="margin-top:16px;display:grid;grid-template-columns:1fr 1fr;gap:8px">
          <% donutData.forEach(d => { %>
            <div style="display:flex;align-items:center;gap:6px;font-size:12px">
              <span style="width:10px;height:10px;border-radius:3px;background:<%= d.color %>"></span>
              <span style="color:var(--gray-600)"><%= d.label %></span>
              <span style="margin-left:auto;font-weight:700"><%= d.value %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">All Results</div>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Exam</th><th>Type</th><th>Subject</th><th>Marks</th><th>%</th><th>Grade</th><th>Date</th></tr></thead>
        <tbody>
          <% if (!results.length) { %>
            <tr><td colspan="7"><div class="empty"><div class="empty-icon">📝</div><div class="empty-title">No results yet</div><div class="empty-sub">Your exam results will appear here.</div></div></td></tr>
          <% } %>
          <% results.forEach(r => { const pct = r.total_marks ? Math.round(r.marks_obtained / r.total_marks * 100) : 0; %>
            <tr>
              <td><strong><%= r.exam_name %></strong></td>
              <td><span class="badge badge-<%= examTypeBadge[r.exam_type] || 'neutral' %>"><%= r.exam_type %></span></td>
              <td><%= r.subject_name %><div class="text-xs text-muted"><%= r.subject_code %></div></td>
              <td><strong><%= r.marks_obtained %></strong>/<%= r.total_marks %><div class="text-xs text-muted">pass <%= r.passing_marks %></div></td>
              <td><span class="badge badge-neutral"><%= pct %>%</span></td>
              <td><span class="badge badge-<%= gradeColor(r.grade) %>"><%= r.grade %></span></td>
              <td class="text-xs text-muted"><%= helpers.formatDate(r.exam_date) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/layout-bottom') %>
