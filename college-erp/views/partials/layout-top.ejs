<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %> — <%= collegeName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <% if (typeof extraCss !== 'undefined' && extraCss) { %><link rel="stylesheet" href="<%= extraCss %>"><% } %>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%236366f1'/><text x='50' y='68' font-size='58' font-family='Arial' font-weight='bold' fill='white' text-anchor='middle'>N</text></svg>">
</head>
<body>
  <div class="page-loader"><div style="text-align:center"><div style="width:60px;height:60px;border-radius:16px;background:var(--gradient-brand);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:26px;margin:0 auto 16px;box-shadow:0 8px 24px rgba(99,102,241,.4)">N</div><div class="spinner" style="margin:0 auto"></div></div></div>

  <div class="app-shell">
    <%- include('sidebar', { nav: typeof nav !== 'undefined' ? nav : '', role: currentUser.role }) %>
    <div class="main-area">
      <%- include('topbar', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard', pageSubtitle: typeof pageSubtitle !== 'undefined' ? pageSubtitle : '' }) %>
      <main class="content-area">
        <% if (typeof flash !== 'undefined' && flash && flash.success) { %><div class="alert alert-success">✅ <%= flash.success %></div><% } %>
        <% if (typeof flash !== 'undefined' && flash && flash.error) { %><div class="alert alert-error">⛔ <%= flash.error %></div><% } %>
