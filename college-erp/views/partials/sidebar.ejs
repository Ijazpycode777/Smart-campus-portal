<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="logo">N</div>
    <div class="brand-text">
      <div class="name"><%= collegeShortName %></div>
      <div class="tag"><%= currentUser.role %> Portal</div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <% if (currentUser.role === 'admin') { %>
      <div class="nav-section">Overview</div>
      <a class="nav-item <%= nav === 'dashboard' ? 'active' : '' %>" href="/admin"><span class="nav-icon">🏠</span> Dashboard</a>
      <a class="nav-item <%= nav === 'analytics' ? 'active' : '' %>" href="/admin/analytics"><span class="nav-icon">📈</span> Analytics</a>

      <div class="nav-section">Academics</div>
      <a class="nav-item <%= nav === 'students' ? 'active' : '' %>" href="/admin/students"><span class="nav-icon">🎓</span> Students</a>
      <a class="nav-item <%= nav === 'teachers' ? 'active' : '' %>" href="/admin/teachers"><span class="nav-icon">👨‍🏫</span> Teachers</a>
      <a class="nav-item <%= nav === 'classes' ? 'active' : '' %>" href="/admin/classes"><span class="nav-icon">🏫</span> Classes</a>
      <a class="nav-item <%= nav === 'courses' ? 'active' : '' %>" href="/admin/courses"><span class="nav-icon">📚</span> Courses</a>
      <a class="nav-item <%= nav === 'subjects' ? 'active' : '' %>" href="/admin/subjects"><span class="nav-icon">📖</span> Subjects</a>
      <a class="nav-item <%= nav === 'departments' ? 'active' : '' %>" href="/admin/departments"><span class="nav-icon">🏛️</span> Departments</a>
      <a class="nav-item <%= nav === 'timetable' ? 'active' : '' %>" href="/admin/timetable"><span class="nav-icon">🗓️</span> Timetable</a>

      <div class="nav-section">Examinations</div>
      <a class="nav-item <%= nav === 'examinations' ? 'active' : '' %>" href="/admin/examinations"><span class="nav-icon">📝</span> Exams</a>
      <a class="nav-item <%= nav === 'results' ? 'active' : '' %>" href="/admin/results"><span class="nav-icon">🎯</span> Results</a>

      <div class="nav-section">Finance</div>
      <a class="nav-item <%= nav === 'fees' ? 'active' : '' %>" href="/admin/fees"><span class="nav-icon">💰</span> Fee Management</a>
      <a class="nav-item <%= nav === 'payments' ? 'active' : '' %>" href="/admin/payments"><span class="nav-icon">💳</span> Payments</a>

      <div class="nav-section">Communication</div>
      <a class="nav-item <%= nav === 'notices' ? 'active' : '' %>" href="/admin/notices"><span class="nav-icon">📢</span> Notices</a>
      <a class="nav-item <%= nav === 'leaves' ? 'active' : '' %>" href="/admin/leaves"><span class="nav-icon">✈️</span> Leave Requests</a>

      <div class="nav-section">System</div>
      <a class="nav-item <%= nav === 'activity' ? 'active' : '' %>" href="/admin/activity"><span class="nav-icon">📋</span> Activity Log</a>
      <a class="nav-item <%= nav === 'settings' ? 'active' : '' %>" href="/admin/settings"><span class="nav-icon">⚙️</span> Settings</a>

    <% } else if (currentUser.role === 'teacher') { %>
      <div class="nav-section">Overview</div>
      <a class="nav-item <%= nav === 'dashboard' ? 'active' : '' %>" href="/teacher"><span class="nav-icon">🏠</span> Dashboard</a>
      <a class="nav-item <%= nav === 'classes' ? 'active' : '' %>" href="/teacher/classes"><span class="nav-icon">🏫</span> My Classes</a>
      <a class="nav-item <%= nav === 'timetable' ? 'active' : '' %>" href="/teacher/timetable"><span class="nav-icon">🗓️</span> Timetable</a>

      <div class="nav-section">Academics</div>
      <a class="nav-item <%= nav === 'attendance' ? 'active' : '' %>" href="/teacher/attendance"><span class="nav-icon">✅</span> Attendance</a>
      <a class="nav-item <%= nav === 'examinations' ? 'active' : '' %>" href="/teacher/examinations"><span class="nav-icon">📝</span> Examinations</a>
      <a class="nav-item <%= nav === 'assignments' ? 'active' : '' %>" href="/teacher/assignments"><span class="nav-icon">📤</span> Assignments</a>
      <a class="nav-item <%= nav === 'materials' ? 'active' : '' %>" href="/teacher/materials"><span class="nav-icon">📚</span> Study Materials</a>

      <div class="nav-section">Communication</div>
      <a class="nav-item <%= nav === 'students' ? 'active' : '' %>" href="/teacher/students"><span class="nav-icon">👥</span> Students</a>
      <a class="nav-item <%= nav === 'notices' ? 'active' : '' %>" href="/teacher/notices"><span class="nav-icon">📢</span> Notices</a>
      <a class="nav-item <%= nav === 'leaves' ? 'active' : '' %>" href="/teacher/leaves"><span class="nav-icon">✈️</span> My Leaves</a>

    <% } else if (currentUser.role === 'student') { %>
      <div class="nav-section">Overview</div>
      <a class="nav-item <%= nav === 'dashboard' ? 'active' : '' %>" href="/student"><span class="nav-icon">🏠</span> Dashboard</a>
      <a class="nav-item <%= nav === 'timetable' ? 'active' : '' %>" href="/student/timetable"><span class="nav-icon">🗓️</span> Timetable</a>

      <div class="nav-section">Academics</div>
      <a class="nav-item <%= nav === 'attendance' ? 'active' : '' %>" href="/student/attendance"><span class="nav-icon">✅</span> Attendance</a>
      <a class="nav-item <%= nav === 'results' ? 'active' : '' %>" href="/student/results"><span class="nav-icon">🎯</span> Results</a>
      <a class="nav-item <%= nav === 'assignments' ? 'active' : '' %>" href="/student/assignments"><span class="nav-icon">📤</span> Assignments</a>
      <a class="nav-item <%= nav === 'materials' ? 'active' : '' %>" href="/student/materials"><span class="nav-icon">📚</span> Study Materials</a>

      <div class="nav-section">Finance</div>
      <a class="nav-item <%= nav === 'fees' ? 'active' : '' %>" href="/student/fees"><span class="nav-icon">💰</span> Fees</a>

      <div class="nav-section">Communication</div>
      <a class="nav-item <%= nav === 'notices' ? 'active' : '' %>" href="/student/notices"><span class="nav-icon">📢</span> Notices</a>
      <a class="nav-item <%= nav === 'leaves' ? 'active' : '' %>" href="/student/leaves"><span class="nav-icon">✈️</span> Leave Requests</a>

    <% } %>
  </nav>

  <div class="sidebar-footer">
    <a class="sidebar-user" href="/profile">
      <div class="avatar" style="background:<%= currentUser.avatarColor %>"><%= helpers.initials(currentUser.fullName) %></div>
      <div class="user-info">
        <div class="name"><%= currentUser.fullName %></div>
        <div class="role"><%= currentUser.role %></div>
      </div>
    </a>
  </div>
</aside>
