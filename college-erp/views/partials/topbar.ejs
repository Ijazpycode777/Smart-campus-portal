<header class="topbar">
  <button class="menu-toggle" data-sidebar-toggle aria-label="Menu">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>

  <div>
    <div class="page-title"><%= pageTitle %></div>
    <% if (pageSubtitle) { %><div class="page-subtitle"><%= pageSubtitle %></div><% } %>
  </div>

  <div class="search">
    <span class="icon">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </span>
    <input type="text" placeholder="Search students, teachers, classes…" id="globalSearch">
  </div>

  <div class="topbar-actions">
    <!-- Notifications -->
    <div class="dropdown">
      <button class="icon-btn" data-notif-trigger data-dropdown>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %><span class="dot"></span><% } %>
      </button>
      <div class="dropdown-menu notif-panel">
        <div style="padding:20px;text-align:center;color:var(--gray-400)">Loading…</div>
      </div>
    </div>

    <!-- Quick help -->
    <a class="icon-btn" href="javascript:void(0)" onclick="ERP.toast('Need help?', 'Contact your administrator for support.', 'info')" title="Help">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </a>

    <!-- User menu -->
    <div class="dropdown">
      <button class="icon-btn" data-dropdown style="width:auto;padding:6px 10px 6px 6px;gap:8px">
        <div class="avatar avatar-sm" style="background:<%= currentUser.avatarColor %>"><%= helpers.initials(currentUser.fullName) %></div>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="dropdown-menu" style="min-width:220px">
        <div style="padding:12px;border-bottom:1px solid var(--border);margin-bottom:6px">
          <div style="font-weight:700;color:var(--gray-900);font-size:13px"><%= currentUser.fullName %></div>
          <div style="font-size:11px;color:var(--gray-500);text-transform:capitalize"><%= currentUser.role %> · @<%= currentUser.username %></div>
        </div>
        <a class="dd-item" href="/profile"><span>👤</span> My Profile</a>
        <a class="dd-item" href="/profile?tab=security"><span>🔒</span> Change Password</a>
        <a class="dd-item" href="/<%= currentUser.role === 'admin' ? 'admin' : currentUser.role %>/notifications"><span>🔔</span> All Notifications</a>
        <div style="height:1px;background:var(--border);margin:6px 0"></div>
        <a class="dd-item" href="/logout" style="color:var(--danger)"><span>🚪</span> Sign Out</a>
      </div>
    </div>
  </div>
</header>
