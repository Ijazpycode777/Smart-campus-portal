# College Management ERP — Environment Configuration
# Copy this file to ".env" and adjust values before running.
# On Render, set these in the dashboard under Environment.

# Server
NODE_ENV=development
PORT=3000

# Session secret — set to a long random string in production
SESSION_SECRET=change-this-to-a-very-long-random-secret-string-in-production

# Database — SQLite file path. On Render use a persistent disk and an absolute path.
DATABASE_PATH=./data/college_erp.sqlite

# Default admin account (created on first seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@college.edu

# Rate limiting / security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
