# ===== SmartCampus 360 — Environment Configuration =====
# Copy this file to ".env" and fill in real values. NEVER commit the .env file.

# Application port (Express + Vite proxy target in dev; production serves on this port)
PORT=4000

# Node environment: development | production
NODE_ENV=development

# Long random string used to sign session cookies. Generate with: openssl rand -hex 64
SESSION_SECRET=change-me-to-a-long-random-hex-string

# 32-byte (256-bit) key for AES-256-GCM encryption of sensitive session data at rest.
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=change-me-to-a-base64-32-byte-key

# Path to the SQLite database file. In production, mount a persistent volume here.
DATABASE_PATH=./data/smartcampus.db

# The frontend origin (used for CORS and CSRF Origin validation)
FRONTEND_URL=http://localhost:5173

# External AI provider API key (optional). If absent, AI features gracefully degrade
# to deterministic rule-based responses, never pretending to call a live service.
AI_API_KEY=

# Directory for uploaded files. Keep this OUTSIDE the Vite public/ directory.
FILE_STORAGE_PATH=./uploads

# Session cookie max age in milliseconds (default: 8 hours)
SESSION_MAX_AGE=28800000

# Session inactivity timeout in milliseconds (default: 30 minutes)
SESSION_INACTIVITY_TIMEOUT=1800000
